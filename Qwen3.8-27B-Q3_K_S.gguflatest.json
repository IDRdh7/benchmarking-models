                "text": "using System;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Net.Http;\nusing System.Text.Json;\nusing System.Threading.Tasks;\n\nnamespace PZWorkshopDownloader.Services;\n\n/// <summary>\n/// One mod's visual + classification data pulled from Steam's public\n/// GetPublishedFileDetails endpoint: the preview image URL and the tag list.\n/// WorkshopApiService is intentionally untouched (it stays minimal), so this\n/// service exists to grab the extra fields (preview_url / tags) the app now\n/// needs for thumbnails and the tag filter sidebar. Requests are batched\n/// (up to 100 ids per call) so one request covers all installed mods.\n/// </summary>\npublic class WorkshopVisual\n{\n    public string Id { get; set; } = \"\";\n    public string PreviewUrl { get; set; } = \"\";\n    public List<string> Tags { get; set; } = new();\n}\n\npublic static class WorkshopVisualService\n{\n    private const string Endpoint =\n        \"https://api.steampowered.com/ISteamRemoteStorage/GetPublishedFileDetails/v1/\";\n\n    private const int MaxPerRequest = 100;\n\n    private static readonly HttpClient Http = new();\n\n    /// <summary>\n    /// Fetches preview_url + tags for the given workshop ids in as few API\n    /// calls as possible. Never throws for an individual item; a hard network\n    /// failure throws and is caught by the caller.\n    /// </summary>\n    public static async Task<Dictionary<string, WorkshopVisual>> GetVisualsAsync(IEnumerable<string> ids)\n    {\n        var idList = ids.Where(id => !string.IsNullOrEmpty(id)).Distinct().ToList();\n        var result = new Dictionary<string, WorkshopVisual>(StringComparer.Ordinal);\n\n        foreach (var chunk in Chunks(idList, MaxPerRequest))\n        {\n            var content = new Dictionary<string, string> { [\"itemcount\"] = chunk.Count.ToString() };\n            for (int i = 0; i < chunk.Count; i++)\n                content[$\"publishedfileids[{i}]\"] = chunk[i];\n\n            var resp = await Http.PostAsync(Endpoint, new FormUrlEncodedContent(content));\n            resp.EnsureSuccessStatusCode();\n\n            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());\n            var list = doc.RootElement.GetProperty(\"response\").GetProperty(\"publishedfiledetails\");\n\n            foreach (var el in list.EnumerateArray())\n            {\n                var id = GetString(el, \"publishedfileid\");\n                if (id == null) continue;\n\n                var visual = new WorkshopVisual\n                {\n                    Id = id,\n                    PreviewUrl = GetString(el, \"preview_url\") ?? \"\",\n                };\n                if (el.TryGetProperty(\"tags\", out var tags) && tags.ValueKind == JsonValueKind.Array)\n                {\n                    foreach (var t in tags.EnumerateArray())\n                        if (t.ValueKind == JsonValueKind.Object && t.TryGetProperty(\"tag\", out var tag))\n                            visual.Tags.Add(tag.ToString());\n                }\n                result[id] = visual;\n            }\n        }\n        return result;\n    }\n\n    private static IEnumerable<List<string>> Chunks(List<string> list, int size)\n    {\n        for (int i = 0; i < list.Count; i += size)\n            yield return list.GetRange(i, Math.Min(size, list.Count - i));\n    }\n\n    private static string? GetString(JsonElement el, string prop) =>\n        el.TryGetProperty(prop, out var v) && v.ValueKind != JsonValueKind.Null ? v.ToString() : null;\n}",
