                "text": "using System;\nusing System.Collections.Generic;\nusing System.Collections.ObjectModel;\nusing System.Linq;\nusing System.Windows;\nusing System.Windows.Controls;\n\nnamespace PZWorkshopDownloader;\n\n/// <summary>\n/// One row in the Show-Deps dialog: a dependency's display title, its\n/// resolved workshop id (null when only an internal name is known), whether\n/// it's currently missing, and the buttons shown for it.\n/// </summary>\npublic class DepDisplay\n{\n    public string Identifier { get; set; } = \"\";   // raw require= value (\"NeatUI_Framework\" or \"123456\")\n    public string Title { get; set; } = \"\";         // best-known display name\n    public string? WorkshopId { get; set; }         // real numeric id if resolved, else null\n    public bool IsMissing { get; set; }\n\n    public bool CanQueue => WorkshopId != null;\n    public string SubText => WorkshopId != null\n        ? (IsMissing ? \"Missing\" : \"Installed\") + $\"  (id {WorkshopId})\"\n        : \"Missing — no workshop id known\";\n}\n\npublic partial class DepsDialog : Window\n{\n    private readonly Action<DepDisplay> _queueOne;\n    private readonly Action<DepDisplay> _openPage;\n\n    public DepsDialog(\n        string modName,\n        IEnumerable<DepDisplay> deps,\n        Action<DepDisplay> queueOne,\n        Action<DepDisplay> openPage)\n    {\n        InitializeComponent();\n        _queueOne = queueOne;\n        _openPage = openPage;\n\n        HeaderText.Text = $\"Dependencies of \\\"{modName}\\\"\";\n        DepsList.ItemsSource = new ObservableCollection<DepDisplay>(deps);\n\n        int unknown = deps.Count(d => d.WorkshopId == null);\n        FooterText.Text = unknown > 0\n            ? $\"{unknown} dependenc{(unknown == 1 ? \"y\" : \"ies\")} had no numeric workshop id and will open a Steam search instead.\"\n            : \"All dependencies have known workshop ids.\";\n    }\n\n    /// <summary>\n    /// Surface a non-fatal lookup error (e.g. the Workshop page couldn't be\n    /// fetched). Keeps the dialog usable for any locally-known dependencies;\n    /// \"Add All\" is disabled since the list may be incomplete.\n    /// </summary>\n    public void ShowError(string message)\n    {\n        AddAllButton.IsEnabled = false;\n        FooterText.Text = message;\n        FooterText.Foreground = System.Windows.Media.Brushes.OrangeRed;\n    }\n\n    private void AddAll_Click(object sender, RoutedEventArgs e)\n    {\n        foreach (var d in DepsList.Items.OfType<DepDisplay>().Where(d => d.CanQueue))\n            _queueOne(d);\n    }\n\n    private void QueueOne_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is FrameworkElement fe && fe.Tag is DepDisplay d && d.CanQueue)\n            _queueOne(d);\n    }\n\n    private void OpenPage_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is FrameworkElement fe && fe.Tag is DepDisplay d)\n            _openPage(d);\n    }\n}",
