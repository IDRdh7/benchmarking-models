alue;\n        _settings.FontSizeButtons = FontButtonsSlider.Value;\n        _settings.FontSizeTabHeaders = FontTabsSlider.Value;\n        _settings.FontSizeLog = FontLogSlider.Value;\n\n        var res = Application.Current.Resources;\n        res[\"UIFontSizeGeneral\"] = _settings.FontSizeGeneral;\n        res[\"UIFontSizeButton\"] = _settings.FontSizeButtons;\n        res[\"UIFontSizeTab\"] = _settings.FontSizeTabHeaders;\n        res[\"UIFontSizeLog\"] = _settings.FontSizeLog;\n\n        UpdateUiLabels();\n        SettingsService.Save(_settings);\n    }\n\n    private void ResetUi_Click(object sender, RoutedEventArgs e)\n    {\n        _settings.FontSizeGeneral = 12.5;\n        _settings.FontSizeButtons = 12.5;\n        _settings.FontSizeTabHeaders = 13.0;\n        _settings.FontSizeLog = 11.0;\n        ApplyUiFontSizes();\n        SettingsService.Save(_settings);\n        AppendLog(\"UI settings reset to defaults.\");\n    }\n\n    private void ThemeCombo_SelectionChanged(object sender, System.Windows.Controls.SelectionChangedEventArgs e)\n    {\n        if (!IsLoaded) return;\n        if (ThemeCombo.SelectedItem is not System.Windows.Controls.ComboBoxItem item) return;\n\n        var themeName = item.Content?.ToString() ?? \"Dark\";\n        _settings.Theme = themeName;\n        SettingsService.Save(_settings);\n        ApplyTheme(themeName);\n        AppendLog($\"Theme changed to: {themeName}\");\n    }\n\n    private static void ApplyTheme(string theme)\n    {\n        // (BgDark, BgPanel, BgField, FgText, AccentBlue, AccentGreen, BorderCol)\n        var palette = theme switch\n        {\n            // The original light theme.\n            \"Light\" => (\"#F0F0F0\", \"#E0E0E0\", \"#FFFFFF\", \"#202020\", \"#2E7BD6\", \"#3E8E41\", \"#C0C0C0\"),\n            // The original Steam-styled dark theme.\n            \"Dark\" => (\"#1B2838\", \"#171A21\", \"#2A2F35\", \"#C7D5E0\", \"#66C0F4\", \"#5C7E10\", \"#3A3F44\"),\n            // Deep indigo/violet with a soft teal-green accent.\n            \"Midnight\" => (\"#14121F\", \"#1E1B2E\", \"#2A2540\", \"#D8D3F0\", \"#9D7CF0\", \"#4CD9A0\", \"#3D3660\"),\n            // Dark forest green with warm lime accent.\n            \"Forest\" => (\"#101C14\", \"#16261B\", \"#1F3327\", \"#D4E8D8\", \"#5FB0A6\", \"#8BC34A\", \"#2E4A38\"),\n            // Nord (arctic, bluish-gray palette by Sven Greb -- nordtheme.com)\n            \"Nord\" => (\"#2E3440\", \"#3B4252\", \"#434C5E\", \"#ECEFF4\", \"#88C0D0\", \"#A3BE8C\", \"#4C566A\"),\n            // Dracula (dracula theme -- draculatheme.com)\n            \"Dracula\" => (\"#282A36\", \"#21222C\", \"#44475A\", \"#F8F8F2\", \"#8BE9FD\", \"#50FA7B\", \"#6272A4\"),\n            // Solarized Dark (Ethan Schoonover -- ethanschoonover.com/solarized)\n            \"Solarized Dark\" => (\"#002B36\", \"#073642\", \"#0A4552\", \"#93A1A1\", \"#268BD2\", \"#859900\", \"#586E75\"),\n            // Solarized Light (same palette, light variant)\n            \"Solarized Light\" => (\"#FDF6E3\", \"#EEE8D5\", \"#FFFFFF\", \"#586E75\", \"#268BD2\", \"#859900\", \"#93A1A1\"),\n            // Gruvbox (retro groove palette by morhetz)\n            \"Gruvbox\" => (\"#282828\", \"#3C3836\", \"#504945\", \"#EBDBB2\", \"#83A598\", \"#B8BB26\", \"#665C54\"),\n            // Monokai (classic Sublime Text scheme)\n            \"Monokai\" => (\"#272822\", \"#1E1F1C\", \"#3E3D32\", \"#F8F8F2\", \"#66D9EF\", \"#A6E22E\", \"#75715E\"),\n            _ => (\"#1B2838\", \"#171A21\", \"#2A2F35\", \"#C7D5E0\", \"#66C0F4\", \"#5C7E10\", \"#3A3F44\"),\n        };\n\n        try\n        {\n            var res = Application.Current.Resources;\n            SetBrush(res, \"BgDark\", palette.Item1);\n            SetBrush(res, \"BgPanel\", palette.Item2);\n            SetBrush(res, \"BgField\", palette.Item3);\n            SetBrush(res, \"FgText\", palette.Item4);\n            SetBrush(res, \"AccentBlue\", palette.Item5);\n            SetBrush(res, \"AccentGreen\", palette.Item6);\n            SetBrush(res, \"BorderCol\", palette.Item7);\n        }\n        catch\n        {\n            // Theming is cosmetic -- never let it take the app down.\n        }\n    }\n\n    private static void SetBrush(ResourceDictionary res, string key, string hex)\n    {\n        // Replace the resource entirely (rather than mutating the existing\n        // brush's Color) -- WPF freezes Freezable resources declared purely\n        // in XAML for performance, which silently blocks in-place mutation.\n        // DynamicResource consumers pick up a replaced entry immediately.\n        res[key] = new SolidColorBrush((Color)ColorConverter.ConvertFromString(hex));\n    }\n}",
