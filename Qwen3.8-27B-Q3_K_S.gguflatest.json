                "text": "using System;\nusing System.Collections.Generic;\nusing System.Net.Http;\nusing System.Text.Json;\nusing System.Threading.Tasks;\n\nnamespace PZWorkshopDownloader.Services;\n\npublic class WorkshopItemDetails\n{\n    public string Id { get; set; } = \"\";\n    public string Title { get; set; } = \"\";\n    public long FileSize { get; set; }\n    public DateTimeOffset TimeCreated { get; set; }\n    public DateTimeOffset TimeUpdated { get; set; }\n\n    /// <summary>\n    /// Steam's \"hcontent_file\" value -- a manifest id that changes every time\n    /// the item's actual file content changes. This is a much better proxy\n    /// for \"version\" than time_updated, which can shift for reasons that\n    /// don't affect the files (title edits, description edits, etc.).\n    /// </summary>\n    public string ContentManifestId { get; set; } = \"\";\n\n    /// <summary>Author's SteamID64. Steam's public API doesn't expose a\n    /// friendly display name without an API key, so this is the raw ID.</summary>\n    public string Creator { get; set; } = \"\";\n}\n\npublic static class WorkshopApiService\n{\n    private static readonly HttpClient Http = new();\n\n    /// <summary>\n    /// Uses Steam's public, key-less GetPublishedFileDetails endpoint.\n    /// Throws if the item id is invalid, private, or removed.\n    /// </summary>\n    public static async Task<WorkshopItemDetails> GetDetailsAsync(string workshopId)\n    {\n        var content = new FormUrlEncodedContent(new Dictionary<string, string>\n        {\n            [\"itemcount\"] = \"1\",\n            [\"publishedfileids[0]\"] = workshopId,\n        });\n\n        var resp = await Http.PostAsync(\n            \"https://api.steampowered.com/ISteamRemoteStorage/GetPublishedFileDetails/v1/\", content);\n        resp.EnsureSuccessStatusCode();\n\n        var json = await resp.Content.ReadAsStringAsync();\n        using var doc = JsonDocument.Parse(json);\n\n        var list = doc.RootElement.GetProperty(\"response\").GetProperty(\"publishedfiledetails\");\n        if (list.GetArrayLength() == 0)\n            throw new Exception($\"No workshop item found for id {workshopId}\");\n\n        var details = list[0];\n        if (!details.TryGetProperty(\"result\", out var result) || result.GetInt32() != 1)\n            throw new Exception($\"Workshop item {workshopId} not found or is private/removed\");\n\n        return new WorkshopItemDetails\n        {\n            Id = workshopId,\n            Title = GetString(details, \"title\") ?? $\"Workshop item {workshopId}\",\n            FileSize = GetLong(details, \"file_size\"),\n            TimeCreated = GetUnixTime(details, \"time_created\"),\n            TimeUpdated = GetUnixTime(details, \"time_updated\"),\n            ContentManifestId = GetString(details, \"hcontent_file\") ?? \"\",\n            Creator = GetString(details, \"creator\") ?? \"\",\n        };\n    }\n\n    // Steam's API sometimes returns numeric fields as JSON strings, so\n    // these helpers accept either representation.\n\n    private static string? GetString(JsonElement el, string prop) =>\n        el.TryGetProperty(prop, out var v) && v.ValueKind != JsonValueKind.Null ? v.ToString() : null;\n\n    private static long GetLong(JsonElement el, string prop)\n    {\n        if (!el.TryGetProperty(prop, out var v)) return 0;\n        return v.ValueKind switch\n        {\n            JsonValueKind.Number => v.GetInt64(),\n            JsonValueKind.String when long.TryParse(v.GetString(), out var parsed) => parsed,\n            _ => 0,\n        };\n    }\n\n    private static DateTimeOffset GetUnixTime(JsonElement el, string prop)\n    {\n        var seconds = GetLong(el, prop);\n        return seconds > 0 ? DateTimeOffset.FromUnixTimeSeconds(seconds) : default;\n    }\n}",
