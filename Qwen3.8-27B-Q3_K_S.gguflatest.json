                "text": "using System;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Net;\nusing System.Net.Http;\nusing System.Text.RegularExpressions;\nusing System.Threading.Tasks;\n\nnamespace PZWorkshopDownloader.Services;\n\npublic class WorkshopRequiredItem\n{\n    public string Id { get; set; } = \"\";\n    public string Title { get; set; } = \"\";\n}\n\n/// <summary>\n/// Reads the Steam Workshop page HTML of a published item and extracts its\n/// \"Required items\" section. The page for any mod lists links to every mod it\n/// depends on (the user picks these links up from the real mod page), which is\n/// the only place a name-only require= entry (e.g. \"\\NeatUI_Framework\") can be\n/// mapped back to a real numeric workshop id.\n///\n/// Best-effort parser: Steam's markup can shift, so failure here only means\n/// name-only dependencies fall back to opening a Steam search instead of a\n/// direct mod page -- never a crash.\n/// </summary>\npublic static class WorkshopPageService\n{\n    private static readonly HttpClient Http = CreateClient();\n\n    private static HttpClient CreateClient()\n    {\n        var c = new HttpClient { Timeout = TimeSpan.FromSeconds(20) };\n        // Steam tends to serve plain HTTP responses to unknown clients; a\n        // browser-like UA avoids odd redirects/blocks.\n        c.DefaultRequestHeaders.UserAgent.ParseAdd(\n            \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36\");\n        return c;\n    }\n\n    public static async Task<List<WorkshopRequiredItem>> GetRequiredItemsAsync(string workshopId)\n    {\n        var url = $\"https://steamcommunity.com/sharedfiles/filedetails/?id={Uri.EscapeDataString(workshopId)}\";\n        var html = await Http.GetStringAsync(url);\n\n        // Scope to the required-items container when present; otherwise fall\n        // back to scanning the whole page (still better than nothing).\n        int start = html.IndexOf(\"requiredItemsContainer\", StringComparison.OrdinalIgnoreCase);\n        var section = start >= 0\n            ? html.Substring(start, Math.Min(20000, html.Length - start))\n            : html;\n\n        // Each dependency is an <a> wrapping a <div class=\"requiredItem\">Title</div>:\n        //   <a href=\"https://steamcommunity.com/workshop/filedetails/?id=3508537032\" ...>\n        //     <div class=\"requiredItem\">NeatUI Framework [B42]</div>\n        //   </a>\n        var items = new List<WorkshopRequiredItem>();\n        var matches = Regex.Matches(\n            section,\n            @\"<a\\s+href=\"\"[^\"\"]*filedetails/\\?id=(\\d+)\"\"[^>]*>\\s*<div[^>]*class=\"\"requiredItem\"\"[^>]*>\\s*(.*?)\\s*</div>\",\n            RegexOptions.Singleline);\n\n        foreach (Match m in matches)\n        {\n            var id = m.Groups[1].Value;\n            var title = Regex.Replace(m.Groups[2].Value, @\"<[^>]+>\", \"\").Trim();\n            title = WebUtility.HtmlDecode(title);\n            if (string.IsNullOrEmpty(title)) continue;\n            if (items.Any(x => x.Id == id)) continue;\n            items.Add(new WorkshopRequiredItem { Id = id, Title = title });\n        }\n        return items;\n    }\n}",
