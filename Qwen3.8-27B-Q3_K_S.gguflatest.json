                "type": "file",
                "path": "H:\\openCode projects\\pzmm - latest version test environment\\MainWindow.xaml",
                "text": "<Window x:Class=\"PZWorkshopDownloader.MainWindow\"\n        xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"\n        xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"\n        xmlns:wv2=\"clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf\"\n        Title=\"Project Zomboid Workshop Downloader\"\n        Height=\"880\" Width=\"1300\" MinHeight=\"600\" MinWidth=\"900\"\n        FontSize=\"{DynamicResource UIFontSizeGeneral}\"\n        Background=\"{DynamicResource BgDark}\">\n\n    <Window.Resources>\n\n        <!-- Batch 4: shared tile thumbnail block (initial-letter placeholder until\n             ThumbnailPath arrives; the image then covers it). Width/Height follow\n             the app-wide ModTileSize resource so the slider resizes every tile. -->\n        <DataTemplate x:Key=\"TileThumbnail\">\n            <Grid Width=\"{DynamicResource ModTileSize}\" Height=\"{DynamicResource ModTileSize}\">\n                <Border Background=\"{DynamicResource BgField}\" CornerRadius=\"6\"\n                        BorderBrush=\"{DynamicResource BorderCol}\" BorderThickness=\"1\">\n                    <TextBlock Text=\"{Binding Initial}\" FontSize=\"26\" FontWeight=\"Bold\"\n                               Foreground=\"{DynamicResource FgText}\" Opacity=\"0.45\"\n                               HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/>\n                </Border>\n                <Image Source=\"{Binding ThumbnailPath}\" Stretch=\"UniformToFill\" Margin=\"2.5\">\n                    <Image.Style>\n                        <Style TargetType=\"Image\">\n                            <Setter Property=\"Visibility\" Value=\"Visible\"/>\n                            <Style.Triggers>\n                                <DataTrigger Binding=\"{Binding ThumbnailPath}\" Value=\"\">\n                                    <Setter Property=\"Visibility\" Value=\"Collapsed\"/>\n                                </DataTrigger>\n                            </Style.Triggers>\n                        </Style>\n                    </Image.Style>\n                </Image>\n            </Grid>\n        </DataTemplate>\n\n        <ContextMenu x:Key=\"DownloadsRowContextMenu\">\n            <MenuItem Header=\"Remove From List\" Click=\"RemoveDownloadEntry_Click\"\n                      Tag=\"{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n        </ContextMenu>\n\n        <ContextMenu x:Key=\"InstalledModsRowContextMenu\">\n            <MenuItem Header=\"Open Mod Folder\" Click=\"OpenFolder_Click\"\n                      Tag=\"{Binding PlacementTarget.Tag.FullPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n            <MenuItem Header=\"Open Mod Page\" Click=\"ModPage_Click\"\n                      Tag=\"{Binding PlacementTarget.Tag.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n            <Separator/>\n            <MenuItem Header=\"Update This Mod\" Click=\"UpdateSingleMod_Click\"\n                      IsEnabled=\"{Binding PlacementTarget.Tag.NeedsUpdate, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"\n                      Tag=\"{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n            <MenuItem Header=\"Force Redownload\" Click=\"ForceRedownloadMod_Click\"\n                      Tag=\"{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n            <MenuItem Header=\"Show Dependencies\" Click=\"ShowDeps_Click\"\n                      IsEnabled=\"{Binding PlacementTarget.Tag.HasDependencies, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"\n                      Tag=\"{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n            <Separator/>\n            <MenuItem Header=\"Uninstall\" Click=\"UninstallMod_Click\"\n                      Tag=\"{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n        </ContextMenu>\n\n        <ContextMenu x:Key=\"UninstalledModsRowContextMenu\">\n            <MenuItem Header=\"Reinstall\" Click=\"ReinstallMod_Click\"\n                      Tag=\"{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n            <MenuItem Header=\"Open Mod Page\" Click=\"ModPage_Click\"\n                      Tag=\"{Binding PlacementTarget.Tag.Id, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n            <Separator/>\n            <MenuItem Header=\"Forget\" Click=\"ForgetUninstalledMod_Click\"\n                      Tag=\"{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}\"/>\n        </ContextMenu>\n\n        <!-- ============ Tile mode (Batch 4) ============\n             Shared styles so all three tile grids stay consistent.\n             NOTE: we pulse via Opacity (DoubleAnimation), never by animating a\n             brush Color. WPF freezes SolidColorBrush instances inside shared\n             DataTemplates, so ColorAnimation on (Foreground).(SolidColorBrush.Color)\n             throws \"Cannot animate on an immutable object instance\". -->\n\n        <!-- Common chrome for every tile button. -->\n        <Style x:Key=\"TileButtonStyle\" TargetType=\"Button\">\n            <Setter Property=\"Background\" Value=\"{DynamicResource BgPanel}\"/>\n            <Setter Property=\"BorderBrush\" Value=\"{DynamicResource BorderCol}\"/>\n            <Setter Property=\"BorderThickness\" Value=\"1\"/>\n            <Setter Property=\"Margin\" Value=\"0,0,10,10\"/>\n            <Setter Property=\"Padding\" Value=\"6\"/>\n            <Setter Property=\"HorizontalContentAlignment\" Value=\"Center\"/>\n            <Setter Property=\"Width\" Value=\"{DynamicResource ModTileSize}\"/>\n        </Style>\n\n        <!-- Mod name text (Installed tiles turn orange+bold when an update is out). -->\n        <Style x:Key=\"TileNameTextStyle\" TargetType=\"TextBlock\">\n            <Setter Property=\"TextWrapping\" Value=\"Wrap\"/>\n            <Setter Property=\"TextAlignment\" Value=\"Center\"/>\n            <Setter Property=\"MaxHeight\" Value=\"34\"/>\n            <Setter Property=\"Margin\" Value=\"0,4,0,2\"/>\n            <Setter Property=\"FontSize\" Value=\"{DynamicResource UIFontSizeGeneral}\"/>\n            <Setter Property=\"Foreground\" Value=\"{DynamicResource FgText}\"/>\n            <Style.Triggers>\n                <DataTrigger Binding=\"{Binding NeedsUpdate}\" Value=\"True\">\n                    <Setter Property=\"Foreground\" Value=\"#FF8C00\"/>\n                    <Setter Property=\"FontWeight\" Value=\"Bold\"/>\n                </DataTrigger>\n            </Style.Triggers>\n        </Style>\n\n        <!-- Status line shared appearance. -->\n        <Style x:Key=\"TileStatusTextBase\" TargetType=\"TextBlock\">\n            <Setter Property=\"FontSize\" Value=\"11\"/>\n            <Setter Property=\"HorizontalAlignment\" Value=\"Center\"/>\n            <Setter Property=\"FontWeight\" Value=\"Bold\"/>\n            <Setter Property=\"Foreground\" Value=\"#3EB489\"/>\n        </Style>\n\n        <!-- Update status: solid green, orange + opacity pulse when NeedsUpdate. -->\n        <Style x:Key=\"TileUpdateStatusText\" TargetType=\"TextBlock\" BasedOn=\"{StaticResource TileStatusTextBase}\">\n            <Style.Triggers>\n                <DataTrigger Binding=\"{Binding NeedsUpdate}\" Value=\"True\">\n                    <Setter Property=\"Foreground\" Value=\"#FF8C00\"/>\n                    <DataTrigger.EnterActions>\n                        <BeginStoryboard x:Name=\"TileUpdatePulse\">\n                            <Storyboard>\n                                <DoubleAnimation Storyboard.TargetProperty=\"Opacity\"\n                                                 From=\"1.0\" To=\"0.45\"\n                                                 Duration=\"0:0:0.9\" AutoReverse=\"True\" RepeatBehavior=\"Forever\"/>\n                            </Storyboard>\n                        </BeginStoryboard>\n                    </DataTrigger.EnterActions>\n                    <DataTrigger.ExitActions>\n                        <StopStoryboard BeginStoryboardName=\"TileUpdatePulse\"/>\n                    </DataTrigger.ExitActions>\n                </DataTrigger>\n            </Style.Triggers>\n        </Style>\n\n        <!-- Requirement status: solid green, orange + opacity pulse when HasMissingDeps. -->\n        <Style x:Key=\"TileRequirementStatusText\" TargetType=\"TextBlock\" BasedOn=\"{StaticResource TileStatusTextBase}\">\n            <Style.Triggers>\n                <DataTrigger Binding=\"{Binding HasMissingDeps}\" Value=\"True\">\n                    <Setter Property=\"Foreground\" Value=\"#FF8C00\"/>\n                    <DataTrigger.EnterActions>\n                        <BeginStoryboard x:Name=\"TileRequirementPulse\">\n                            <Storyboard>\n                                <DoubleAnimation Storyboard.TargetProperty=\"Opacity\"\n                                                 From=\"1.0\" To=\"0.45\"\n                                                 Duration=\"0:0:0.9\" AutoReverse=\"True\" RepeatBehavior=\"Forever\"/>\n                            </Storyboard>\n                        </BeginStoryboard>\n                    </DataTrigger.EnterActions>\n                    <DataTrigger.ExitActions>\n                        <StopStoryboard BeginStoryboardName=\"TileRequirementPulse\"/>\n                    </DataTrigger.ExitActions>\n                </DataTrigger>\n            </Style.Triggers>\n        </Style>\n\n    </Window.Resources>\n\n    <Grid Background=\"{DynamicResource BgDark}\">\n        <Grid.RowDefinitions>\n            <RowDefinition Height=\"*\"/>\n            <RowDefinition Height=\"Auto\"/>\n        </Grid.RowDefinitions>\n        <Grid.ColumnDefinitions>\n            <ColumnDefinition Width=\"*\"/>\n            <ColumnDefinition x:Name=\"QueueColumn\" Width=\"0\"/>\n        </Grid.ColumnDefinitions>\n\n        <TabControl x:Name=\"MainTabs\" Grid.Row=\"0\" Grid.Column=\"0\" Background=\"{DynamicResource BgPanel}\"\n                    BorderThickness=\"0\" Margin=\"0\">\n\n            <!-- ============ BROWSER TAB ============ -->\n            <TabItem Header=\"Browser\" x:Name=\"BrowserTabItem\">\n                <Grid Background=\"{DynamicResource BgDark}\">\n                    <Grid.RowDefinitions>\n                        <RowDefinition Height=\"Auto\"/>\n                        <RowDefinition Height=\"Auto\"/>\n                        <RowDefinition Height=\"*\"/>\n                    </Grid.RowDefinitions>\n\n                    <!-- Address bar -->\n                    <Grid Grid.Row=\"0\" Margin=\"8,8,8,4\">\n                        <Grid.ColumnDefinitions>\n                            <ColumnDefinition Width=\"Auto\"/>\n                            <ColumnDefinition Width=\"Auto\"/>\n                            <ColumnDefinition Width=\"Auto\"/>\n                            <ColumnDefinition Width=\"*\"/>\n                        </Grid.ColumnDefinitions>\n                        <Button Grid.Column=\"0\" Content=\"&#9664;\" Click=\"Back_Click\" ToolTip=\"Back\"/>\n                        <Button Grid.Column=\"1\" Content=\"&#9654;\" Click=\"Forward_Click\" ToolTip=\"Forward\"/>\n                        <Button Grid.Column=\"2\" Content=\"&#8962;\" Click=\"Home_Click\" ToolTip=\"Workshop Home\"/>\n                        <TextBox x:Name=\"AddressBar\" Grid.Column=\"3\" Margin=\"6,0,0,0\"\n                                 VerticalContentAlignment=\"Center\" KeyDown=\"AddressBar_KeyDown\"/>\n                    </Grid>\n\n                    <!-- Action buttons -->\n                    <StackPanel Grid.Row=\"1\" Orientation=\"Horizontal\" Margin=\"8,0,8,6\">\n                        <TextBlock Text=\"Folder:\" Foreground=\"{DynamicResource FgText}\" VerticalAlignment=\"Center\" Margin=\"3\"/>\n                        <TextBlock x:Name=\"DestFolderLabel\" Text=\"Not set\" Foreground=\"{DynamicResource AccentBlue}\"\n                                   VerticalAlignment=\"Center\" Margin=\"0,0,10,0\" MaxWidth=\"260\"\n                                   TextTrimming=\"CharacterEllipsis\"/>\n                        <Button Content=\"Download This Mod/Collection\" Click=\"DownloadCurrent_Click\" Margin=\"20,3,3,3\"\n                                Background=\"{DynamicResource AccentGreen}\" Foreground=\"White\" FontWeight=\"Bold\"/>\n                        <Button Content=\"Add To Queue\" Click=\"AddToQueue_Click\"/>\n                    </StackPanel>\n\n                    <!-- Browser -->\n                    <wv2:WebView2 x:Name=\"Browser\" Grid.Row=\"2\"\n                                  Source=\"https://steamcommunity.com/workshop/browse/?appid=108600&amp;browsesort=trend&amp;section=readytouseitems\"/>\n                </Grid>\n            </TabItem>\n\n            <!-- ============ DOWNLOADS TAB ============ -->\n            <TabItem Header=\"Downloads\">\n                <Grid Background=\"{DynamicResource BgDark}\">\n                    <Grid.RowDefinitions>\n                        <RowDefinition Height=\"Auto\"/>\n                        <RowDefinition Height=\"Auto\"/>\n                        <RowDefinition Height=\"*\"/>\n                    </Grid.RowDefinitions>\n\n                    <StackPanel Grid.Row=\"0\" Orientation=\"Horizontal\" Margin=\"8,8,8,0\">\n                        <Button Content=\"Clear Finished\" Click=\"ClearFinishedDownloads_Click\"/>\n                        <Button Content=\"Clear All\" Click=\"ClearAllDownloads_Click\"/>\n                    </StackPanel>\n\n                    <!-- View toggle + tile size -->\n                    <StackPanel Grid.Row=\"1\" Orientation=\"Horizontal\" Margin=\"8,4,8,4\">\n                        <ToggleButton x:Name=\"DownloadsListToggle\" Content=\"&#9776; List\" Tag=\"List\"\n                                      IsChecked=\"True\" Checked=\"DownloadsView_Checked\" Padding=\"8,3\"/>\n                        <ToggleButton x:Name=\"DownloadsTilesToggle\" Content=\"&#9638; Tiles\" Tag=\"Tiles\"\n                                      Checked=\"DownloadsView_Checked\" Padding=\"8,3\" Margin=\"4,0,0,0\"/>\n                        <TextBlock Text=\"Tile size:\" VerticalAlignment=\"Center\" Margin=\"14,0,4,0\"\n                                   Foreground=\"{DynamicResource FgText}\"/>\n                        <Slider Width=\"140\" Minimum=\"80\" Maximum=\"260\" Value=\"140\"\n                                ValueChanged=\"ModTileSize_Changed\" VerticalAlignment=\"Center\"\n                                IsSnapToTickEnabled=\"True\" TickFrequency=\"10\"/>\n                    </StackPanel>\n\n                    <Grid Grid.Row=\"2\" Margin=\"8,0,8,8\">\n                        <DataGrid x:Name=\"DownloadsGrid\">\n                            <DataGrid.RowStyle>\n                                <Style TargetType=\"DataGridRow\">\n                                    <Setter Property=\"Tag\" Value=\"{Binding}\"/>\n                                    <Setter Property=\"ContextMenu\" Value=\"{StaticResource DownloadsRowContextMenu}\"/>\n                                    <Style.Triggers>\n                                        <Trigger Property=\"IsMouseOver\" Value=\"True\">\n                                            <Setter Property=\"Background\" Value=\"#1EFFFFFF\"/>\n                                        </Trigger>\n                                    </Style.Triggers>\n                                </Style>\n                            </DataGrid.RowStyle>\n                            <DataGrid.Columns>\n                                <DataGridTemplateColumn Header=\"\" Width=\"42\">\n                                    <DataGridTemplateColumn.CellTemplate>\n                                        <DataTemplate>\n                                            <Grid Width=\"32\" Height=\"32\">\n                                                <Border Background=\"{DynamicResource BgField}\" CornerRadius=\"4\"\n                                                        BorderBrush=\"{DynamicResource BorderCol}\" BorderThickness=\"1\">\n                                                    <TextBlock Text=\"{Binding Initial}\" FontSize=\"14\" FontWeight=\"Bold\"\n                                                               Foreground=\"{DynamicResource FgText}\" Opacity=\"0.45\"\n                                                               HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/>\n                                                </Border>\n                                                <Image Source=\"{Binding ThumbnailPath}\" Stretch=\"UniformToFill\" Margin=\"1.5\">\n                                                    <Image.Style>\n                                                        <Style TargetType=\"Image\">\n                                                            <Setter Property=\"Visibility\" Value=\"Visible\"/>\n                                                            <Style.Triggers>\n                                                                <DataTrigger Binding=\"{Binding ThumbnailPath}\" Value=\"\">\n                                                                    <Setter Property=\"Visibility\" Value=\"Collapsed\"/>\n                                                                </DataTrigger>\n                                                            </Style.Triggers>\n                                                        </Style>\n                                                    </Image.Style>\n                                                </Image>\n                                            </Grid>\n                                        </DataTemplate>\n                                    </DataGridTemplateColumn.CellTemplate>\n                                </DataGridTemplateColumn>\n                                <DataGridTextColumn Header=\"Status\" Binding=\"{Binding Status}\" Width=\"100\"/>\n                                <DataGridTextColumn Header=\"Mod\" Binding=\"{Binding Title}\" Width=\"*\"/>\n                                <DataGridTextColumn Header=\"Detail\" Binding=\"{Binding Detail}\" Width=\"280\"/>\n                                <DataGridTextColumn Header=\"Started\" Binding=\"{Binding StartedAt}\" Width=\"100\"/>\n                                <DataGridTextColumn Header=\"Finished\" Binding=\"{Binding FinishedAt}\" Width=\"100\"/>\n                            </DataGrid.Columns>\n                        </DataGrid>\n\n                        <ScrollViewer Visibility=\"{Binding Visibility, ElementName=DownloadsTiles}\" VerticalScrollBarVisibility=\"Auto\" HorizontalScrollBarVisibility=\"Disabled\">\n                            <ItemsControl x:Name=\"DownloadsTiles\" Visibility=\"Collapsed\" Margin=\"0,2,0,0\">\n                                <ItemsControl.ItemsPanel>\n                                    <ItemsPanelTemplate>\n                                        <WrapPanel/>\n                                    </ItemsPanelTemplate>\n                                </ItemsControl.ItemsPanel>\n                                <ItemsControl.ItemTemplate>\n                                    <DataTemplate>\n                                        <Button Click=\"ModPage_Click\" Tag=\"{Binding}\"\n                                                Style=\"{StaticResource TileButtonStyle}\"\n                                                ContextMenu=\"{StaticResource DownloadsRowContextMenu}\"\n                                                ToolTip=\"{Binding Title}\">\n                                            <StackPanel>\n                                                <ContentControl Content=\"{Binding}\" ContentTemplate=\"{StaticResource TileThumbnail}\"/>\n                                                <TextBlock Text=\"{Binding Title}\" Style=\"{StaticResource TileNameTextStyle}\"/>\n                                                <TextBlock Text=\"{Binding Status}\" Style=\"{StaticResource TileStatusTextBase}\"\n                                                           Foreground=\"{DynamicResource AccentBlue}\"/>\n                                            </StackPanel>\n                                        </Button>\n                                    </DataTemplate>\n                                </ItemsControl.ItemTemplate>\n                            </ItemsControl>\n                        </ScrollViewer>\n                    </Grid>\n                </Grid>\n            </TabItem>\n\n            <!-- ============ INSTALLED MODS TAB (also handles update checking) ============ -->\n            <TabItem Header=\"Installed Mods\" x:Name=\"InstalledModsTabItem\">\n                <Grid Background=\"{DynamicResource BgDark}\">\n                    <Grid.RowDefinitions>\n                        <RowDefinition Height=\"Auto\"/>\n                        <RowDefinition Height=\"Auto\"/>\n                        <RowDefinition Height=\"*\"/>\n                    </Grid.RowDefinitions>\n\n                    <Grid Grid.Row=\"0\" Margin=\"8,8,8,0\">\n                        <Grid.ColumnDefinitions>\n                            <ColumnDefinition Width=\"Auto\"/>\n                            <ColumnDefinition Width=\"Auto\"/>\n                            <ColumnDefinition Width=\"Auto\"/>\n                            <ColumnDefinition Width=\"Auto\"/>\n                            <ColumnDefinition Width=\"*\"/>\n                        </Grid.ColumnDefinitions>\n                        <Button Grid.Column=\"0\" Content=\"Refresh Mod List\" Click=\"RefreshDownloadedMods_Click\"/>\n                        <Button x:Name=\"UpdateAllButton\" Grid.Column=\"1\" Content=\"Update All\" Click=\"UpdateAllButton_Click\"\n                                IsEnabled=\"False\" Margin=\"10,3,3,3\"\n                                Background=\"{DynamicResource AccentGreen}\" Foreground=\"White\" FontWeight=\"Bold\"/>\n                        <Button Grid.Column=\"2\" Content=\"Export List...\" Click=\"ExportModList_Click\" Margin=\"10,3,3,3\"/>\n                        <Button Grid.Column=\"3\" Content=\"Import List...\" Click=\"ImportModList_Click\"/>\n                        <TextBlock x:Name=\"UpdatesAvailableText\" Grid.Column=\"4\"\n                                   Foreground=\"{DynamicResource FgText}\" VerticalAlignment=\"Center\"\n                                   HorizontalAlignment=\"Right\" Margin=\"0,0,10,0\"\n                                   Text=\"Mods with updates available: 0\"/>\n                    </Grid>\n\n                    <!-- View toggle + tile size + tag sidebar collapse -->\n                    <StackPanel Grid.Row=\"1\" Orientation=\"Horizontal\" Margin=\"8,4,8,4\">\n                        <ToggleButton x:Name=\"InstalledListToggle\" Content=\"&#9776; List\" Tag=\"List\"\n                                      IsChecked=\"True\" Checked=\"InstalledView_Checked\" Padding=\"8,3\"/>\n                        <ToggleButton x:Name=\"InstalledTilesToggle\" Content=\"&#9638; Tiles\" Tag=\"Tiles\"\n                                      Checked=\"InstalledView_Checked\" Padding=\"8,3\" Margin=\"4,0,0,0\"/>\n                        <TextBlock Text=\"Tile size:\" VerticalAlignment=\"Center\" Margin=\"14,0,4,0\"\n                                   Foreground=\"{DynamicResource FgText}\"/>\n                        <Slider Width=\"140\" Minimum=\"80\" Maximum=\"260\" Value=\"140\"\n                                ValueChanged=\"ModTileSize_Changed\" VerticalAlignment=\"Center\"\n                                IsSnapToTickEnabled=\"True\" TickFrequency=\"10\"/>\n                        <Button x:Name=\"TagSidebarToggle\" Content=\"&#9664;\" Click=\"ToggleTagSidebar_Click\"\n                                Padding=\"8,3\" Margin=\"14,0,0,0\" ToolTip=\"Toggle tag filter sidebar\"/>\n                    </StackPanel>\n\n                    <!-- Content: tag filter sidebar + list/tiles -->\n                    <Grid Grid.Row=\"2\" Margin=\"8,0,8,8\">\n                        <Grid.ColumnDefinitions>\n                            <ColumnDefinition x:Name=\"TagSidebarColumn\" Width=\"190\"/>\n                            <ColumnDefinition Width=\"*\"/>\n                        </Grid.ColumnDefinitions>\n\n                        <!-- Tag filter sidebar -->\n                        <Border Grid.Column=\"0\" Margin=\"0,0,8,0\" Background=\"{DynamicResource BgPanel}\"\n                                BorderBrush=\"{DynamicResource BorderCol}\" BorderThickness=\"1\" CornerRadius=\"4\"\n                                Padding=\"8\">\n                            <DockPanel>\n                                <TextBlock DockPanel.Dock=\"Top\" Text=\"Filter by tag\"\n                                           Foreground=\"{DynamicResource AccentBlue}\" FontWeight=\"Bold\" Margin=\"0,0,0,6\"/>\n                                <StackPanel DockPanel.Dock=\"Top\" Orientation=\"Horizontal\" Margin=\"0,0,0,6\">\n                                    <Button Content=\"Select All\" Click=\"SelectAllTags_Click\" Padding=\"6,2\" FontSize=\"11\"/>\n                                    <Button Content=\"Clear\" Click=\"ClearTags_Click\" Padding=\"6,2\" FontSize=\"11\" Margin=\"6,0,0,0\"/>\n                                </StackPanel>\n                                <TextBlock x:Name=\"TagCountText\" DockPanel.Dock=\"Top\" Text=\"0 tag(s)\"\n                                           Foreground=\"{DynamicResource FgText}\" Opacity=\"0.7\" FontSize=\"11\" Margin=\"0,0,0,4\"/>\n                                <ScrollViewer VerticalScrollBarVisibility=\"Auto\" HorizontalScrollBarVisibility=\"Disabled\">\n                                    <StackPanel x:Name=\"TagFilterPanel\"/>\n                                </ScrollViewer>\n                            </DockPanel>\n                        </Border>\n\n                        <DataGrid x:Name=\"DownloadedModsGrid\" Grid.Column=\"1\">\n                            <DataGrid.RowStyle>\n                                <Style TargetType=\"DataGridRow\">\n                                    <Setter Property=\"Tag\" Value=\"{Binding}\"/>\n                                    <Setter Property=\"ContextMenu\" Value=\"{StaticResource InstalledModsRowContextMenu}\"/>\n                                    <Style.Triggers>\n                                        <Trigger Property=\"IsMouseOver\" Value=\"True\">\n                                            <Setter Property=\"Background\" Value=\"#1EFFFFFF\"/>\n                                        </Trigger>\n                                    </Style.Triggers>\n                                </Style>\n                            </DataGrid.RowStyle>\n                            <DataGrid.Columns>\n                                <DataGridTemplateColumn Header=\"\" Width=\"42\" SortMemberPath=\"ModName\">\n                                    <DataGridTemplateColumn.CellTemplate>\n                                        <DataTemplate>\n                                            <Grid Width=\"32\" Height=\"32\">\n                                                <Border Background=\"{DynamicResource BgField}\" CornerRadius=\"4\"\n                                                        BorderBrush=\"{DynamicResource BorderCol}\" BorderThickness=\"1\">\n                                                    <TextBlock Text=\"{Binding Initial}\" FontSize=\"14\" FontWeight=\"Bold\"\n                                                               Foreground=\"{DynamicResource FgText}\" Opacity=\"0.45\"\n                                                               HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"/>\n                                                </Border>\n                                                <Image Source=\"{Binding ThumbnailPath}\" Stretch=\"UniformToFill\" Margin=\"1.5\">\n                                                    <Image.Style>\n                                                        <Style TargetType=\"Image\">\n                                                            <Setter Property=\"Visibility\" Value=\"Visible\"/>\n                                                            <Style.Triggers>\n                                                                <DataTrigger Binding=\"{Binding ThumbnailPath}\" Value=\"\">\n                                                                    <Setter Property=\"Visibility\" Value=\"Collapsed\"/>\n                                                                </DataTrigger>\n                                                            </Style.Triggers>\n                                                        </Style>\n                                                    </Image.Style>\n                                                </Image>\n                                            </Grid>\n                                        </DataTemplate>\n                                    </DataGridTemplateColumn.CellTemplate>\n                                </DataGridTemplateColumn>\n                                <DataGridTextColumn Header=\"Folder\" Binding=\"{Binding Folder}\" Width=\"2*\"/>\n                            <DataGridTextColumn Header=\"Mod Name\" Binding=\"{Binding ModName}\" Width=\"3*\"/>\n                            <DataGridTemplateColumn Header=\"Status\" Width=\"1.6*\" SortMemberPath=\"StatusLabel\">\n                                <DataGridTemplateColumn.CellTemplate>\n                                    <DataTemplate>\n                                        <TextBlock Text=\"{Binding StatusLabel}\" FontWeight=\"Bold\" VerticalAlignment=\"Center\">\n                                            <TextBlock.Style>\n                                                <Style TargetType=\"TextBlock\">\n                                                    <Setter Property=\"Foreground\" Value=\"#3EB489\"/>\n                                                    <Style.Triggers>\n                                                        <DataTrigger Binding=\"{Binding NeedsUpdate}\" Value=\"True\">\n                                                            <Setter Property=\"Foreground\" Value=\"#FF8C00\"/>\n                                                            <DataTrigger.EnterActions>\n                                                                <BeginStoryboard x:Name=\"PulseStoryboard\">\n                                                                    <Storyboard>\n                                                                        <DoubleAnimation Storyboard.TargetProperty=\"Opacity\"\n                                                                                         From=\"1.0\" To=\"0.45\"\n                                                                                         Duration=\"0:0:0.9\" AutoReverse=\"True\" RepeatBehavior=\"Forever\"/>\n                                                                    </Storyboard>\n                                                                </BeginStoryboard>\n                                                            </DataTrigger.EnterActions>\n                                                            <DataTrigger.ExitActions>\n                                                                <StopStoryboard BeginStoryboardName=\"PulseStoryboard\"/>\n                                                            </DataTrigger.ExitActions>\n                                                        </DataTrigger>\n                                                    </Style.Triggers>\n                                                </Style>\n                                            </TextBlock.Style>\n                                        </TextBlock>\n                                    </DataTemplate>\n                                </DataGridTemplateColumn.CellTemplate>\n                            </DataGridTemplateColumn>\n                            <DataGridTemplateColumn Header=\"Requirements\" Width=\"1.6*\" SortMemberPath=\"RequirementLabel\">\n                                <DataGridTemplateColumn.CellTemplate>\n                                    <DataTemplate>\n                                        <TextBlock Text=\"{Binding RequirementLabel}\" FontWeight=\"Bold\" VerticalAlignment=\"Center\">\n                                            <TextBlock.Style>\n                                                <Style TargetType=\"TextBlock\">\n                                                    <Setter Property=\"Foreground\" Value=\"#3EB489\"/>\n                                                    <Style.Triggers>\n                                                        <DataTrigger Binding=\"{Binding HasMissingDeps}\" Value=\"True\">\n                                                            <Setter Property=\"Foreground\" Value=\"#FF8C00\"/>\n                                                            <DataTrigger.EnterActions>\n                                                                <BeginStoryboard x:Name=\"ReqPulseStoryboard\">\n                                                                    <Storyboard>\n                                                                        <DoubleAnimation Storyboard.TargetProperty=\"Opacity\"\n                                                                                         From=\"1.0\" To=\"0.45\"\n                                                                                         Duration=\"0:0:0.9\" AutoReverse=\"True\" RepeatBehavior=\"Forever\"/>\n                                                                    </Storyboard>\n                                                                </BeginStoryboard>\n                                                            </DataTrigger.EnterActions>\n                                                            <DataTrigger.ExitActions>\n                                                                <StopStoryboard BeginStoryboardName=\"ReqPulseStoryboard\"/>\n                                                            </DataTrigger.ExitActions>\n                                                        </DataTrigger>\n                                                    </Style.Triggers>\n                                                </Style>\n                                            </TextBlock.Style>\n                                        </TextBlock>\n                                    </DataTemplate>\n                                </DataGridTemplateColumn.CellTemplate>\n                            </DataGridTemplateColumn>\n                            <DataGridTextColumn Header=\"Tags\" Binding=\"{Binding TagsLabel}\" Width=\"1.4*\"/>\n                            <DataGridTextColumn Header=\"Size\" Binding=\"{Binding Size}\" Width=\"0.9*\"/>\n                            <DataGridTextColumn Header=\"Install Date\" Binding=\"{Binding InstallDate}\" Width=\"1.2*\"/>\n                            <DataGridTextColumn Header=\"Local Version\" Binding=\"{Binding LocalVersion}\" Width=\"1.1*\"/>\n                            <DataGridTextColumn Header=\"Steam Version\" Binding=\"{Binding SteamVersion}\" Width=\"1.1*\"/>\n                            <DataGridTemplateColumn Header=\"\" Width=\"36\">\n                                <DataGridTemplateColumn.CellTemplate>\n                                    <DataTemplate>\n                                        <Button Content=\"&#128193;\" Tag=\"{Binding FullPath}\" Click=\"OpenFolder_Click\"\n                                                ToolTip=\"Open Mod Folder\" Width=\"30\" Height=\"30\" Padding=\"0\"\n                                                Margin=\"0\" HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"\n                                                FontSize=\"15\"/>\n                                    </DataTemplate>\n                                </DataGridTemplateColumn.CellTemplate>\n                            </DataGridTemplateColumn>\n                            <DataGridTemplateColumn Header=\"\" Width=\"36\">\n                                <DataGridTemplateColumn.CellTemplate>\n                                    <DataTemplate>\n                                        <Button Content=\"&#128279;\" Tag=\"{Binding Id}\" Click=\"ModPage_Click\"\n                                                ToolTip=\"Open Mod Page\" Width=\"30\" Height=\"30\" Padding=\"0\"\n                                                Margin=\"0\" HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"\n                                                FontSize=\"15\"/>\n                                    </DataTemplate>\n                                </DataGridTemplateColumn.CellTemplate>\n                            </DataGridTemplateColumn>\n                            <DataGridTemplateColumn Header=\"\" Width=\"36\">\n                                <DataGridTemplateColumn.CellTemplate>\n                                    <DataTemplate>\n                                        <Button Content=\"&#11015;\" Tag=\"{Binding}\" Click=\"UpdateSingleMod_Click\"\n                                                ToolTip=\"Update This Mod\" Width=\"30\" Height=\"30\" Padding=\"0\"\n                                                Margin=\"0\" HorizontalAlignment=\"Center\" VerticalAlignment=\"Center\"\n                                                FontSize=\"15\"\n                                                Background=\"{DynamicResource AccentGreen}\" Foreground=\"White\" FontWeight=\"Bold\"