                "text": "using System;\nusing System.Diagnostics;\nusing System.Windows;\n\nnamespace PZWorkshopDownloader;\n\npublic partial class AboutWindow : Window\n{\n    // No repository has been created for this project yet. Once you publish\n    // one, replace this constant with the real URL and the button below\n    // will link straight to it.\n    public const string GitHubUrl = \"https://github.com/\";\n    private const bool GitHubConfigured = false;\n\n    public const string AppVersion = \"1.0.0\";\n\n    public AboutWindow()\n    {\n        InitializeComponent();\n        VersionText.Text = $\"Version {AppVersion}\";\n\n        if (!GitHubConfigured)\n        {\n            GitHubButton.IsEnabled = false;\n            GitHubNoteText.Text = \"No GitHub repository has been configured for this project yet.\";\n        }\n    }\n\n    private void GitHubButton_Click(object sender, RoutedEventArgs e)\n    {\n        try\n        {\n            Process.Start(new ProcessStartInfo(GitHubUrl) { UseShellExecute = true });\n        }\n        catch (Exception ex)\n        {\n            MessageBox.Show($\"Could not open browser: {ex.Message}\");\n        }\n    }\n\n    private void Close_Click(object sender, RoutedEventArgs e) => Close();\n}",
