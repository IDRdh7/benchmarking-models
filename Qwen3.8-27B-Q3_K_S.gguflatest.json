                "text": "using System;\nusing System.IO;\nusing System.Windows;\nusing System.Windows.Threading;\n\nnamespace PZWorkshopDownloader;\n\npublic partial class App : Application\n{\n    private static readonly string LogPath = Path.Combine(\n        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),\n        \"PZWorkshopDownloader\", \"crash.log\");\n\n    protected override void OnStartup(StartupEventArgs e)\n    {\n        base.OnStartup(e);\n\n        DispatcherUnhandledException += (_, args) =>\n        {\n            LogAndShow(args.Exception, \"UI thread\");\n            args.Handled = true; // keep the app alive so you can see the message\n        };\n\n        AppDomain.CurrentDomain.UnhandledException += (_, args) =>\n        {\n            LogAndShow(args.ExceptionObject as Exception, \"background thread (fatal)\");\n        };\n\n        System.Threading.Tasks.TaskScheduler.UnobservedTaskException += (_, args) =>\n        {\n            LogAndShow(args.Exception, \"async task\");\n            args.SetObserved();\n        };\n    }\n\n    private static void LogAndShow(Exception? ex, string where)\n    {\n        var text = $\"[{DateTime.Now}] Unhandled exception on {where}:\\n{ex}\\n\\n\";\n        try\n        {\n            Directory.CreateDirectory(Path.GetDirectoryName(LogPath)!);\n            File.AppendAllText(LogPath, text);\n        }\n        catch\n        {\n            // If we can't even write the log, fall through to the message box anyway.\n        }\n\n        MessageBox.Show(\n            $\"An unexpected error occurred on the {where}:\\n\\n{ex?.Message}\\n\\n\" +\n            $\"Full details were saved to:\\n{LogPath}\",\n            \"PZ Workshop Downloader — Error\",\n            MessageBoxButton.OK, MessageBoxImage.Error);\n    }\n}\n",
