                "text": "using System.Collections.Generic;\nusing System.ComponentModel;\nusing System.Runtime.CompilerServices;\n\nnamespace PZWorkshopDownloader.Models;\n\npublic class ModRecord : INotifyPropertyChanged\n{\n    public string Folder { get; set; } = \"\";\n    public string FullPath { get; set; } = \"\";\n    public string Id { get; set; } = \"\";\n    public string ModName { get; set; } = \"\";\n\n    // Used on the Updater tab\n    public string LocalVersion { get; set; } = \"\";\n    public string SteamVersion { get; set; } = \"\";\n    public string DownloadSize { get; set; } = \"\";\n    public bool NeedsUpdate { get; set; }\n    public string StatusLabel { get; set; } = \"Updated\";\n    public string Creator { get; set; } = \"\";\n\n    // ================= Items 1-3: Dependency handling =================\n    // Dependency identifiers parsed from this mod's require= field of mod.info\n    // (numeric workshop IDs and/or internal mod names like \"NeatUI_Framework\").\n    public List<string> Dependencies { get; set; } = new();\n\n    // The subset of Dependencies that could NOT be matched to an installed mod\n    // under the user's mods folder. Drives the \"Show Deps\" dialog (missing\n    // numeric entries can be queued; name-only entries open Steam search).\n    public List<string> MissingDependencies { get; set; } = new();\n\n    // Count of dependencies that do not have a corresponding installed folder under the user's mods folder.\n    public int MissingDepsCount { get; set; }\n\n    // Used by the Requirements status column (green \"Met\" / pulsing orange \"Missing\").\n    public bool HasMissingDeps => MissingDepsCount > 0;\n\n    public bool HasDependencies => Dependencies.Count > 0;\n\n    public string RequirementLabel => Dependencies.Count == 0\n        ? \"No Requirements\"\n        : MissingDepsCount == 0 ? \"Requirements Met\" : $\"{MissingDepsCount} missing\";\n\n    // Used on the Downloader tab\n    public string Size { get; set; } = \"\";\n    public string Posted { get; set; } = \"\";\n    public string Updated { get; set; } = \"\";\n    public string InstallDate { get; set; } = \"\";\n\n    // ================= Batch 4: visual subsystem =================\n    // Path to the locally cached thumbnail (set asynchronously after the grid\n    // is populated, hence INPC). Empty until the fetch/download completes.\n    private string _thumbnailPath = \"\";\n    public string ThumbnailPath\n    {\n        get => _thumbnailPath;\n        set { if (_thumbnailPath != value) { _thumbnailPath = value; OnPropertyChanged(); } }\n    }\n\n    // Steam workshop tags for this mod (e.g. \"Map\", \"Survivor\", ...) used by\n    // the tag filter sidebar. Populated by the same visual fetch as the thumbnail.\n    public List<string> Tags { get; set; } = new();\n\n    // Comma-separated tag string for the Tags grid column.\n    public string TagsLabel => Tags.Count == 0 ? \"\" : string.Join(\", \", Tags);\n\n    // First character of the display name — the placeholder shown until the\n    // thumbnail arrives (or forever, for mods without a preview image).\n    public string Initial => ModName.Length > 0 ? ModName[..1].ToUpperInvariant() : \"?\";\n\n    public event PropertyChangedEventHandler? PropertyChanged;\n\n    protected void OnPropertyChanged([CallerMemberName] string? name = null) =>\n        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));\n}",
