                "text": "using System;\nusing System.Collections.Generic;\nusing System.Diagnostics;\nusing System.IO;\nusing System.IO.Compression;\nusing System.Linq;\nusing System.Net.Http;\nusing System.Text.RegularExpressions;\nusing System.Threading;\nusing System.Threading.Tasks;\n\nnamespace PZWorkshopDownloader.Services;\n\npublic static class SteamCmdService\n{\n    public const string AppId = \"108600\"; // Project Zomboid\n\n    private static readonly string AppDir = Path.Combine(\n        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),\n        \"PZWorkshopDownloader\");\n\n    private static readonly string SteamCmdDir = Path.Combine(AppDir, \"steamcmd\");\n    private static readonly string SteamCmdExe = Path.Combine(SteamCmdDir, \"steamcmd.exe\");\n    private const string SteamCmdZipUrl = \"https://steamcdn-a.akamaihd.net/client/installer/steamcmd.zip\";\n\n    private static bool _bootstrapped = false;\n    private static readonly SemaphoreSlim RunLock = new(1, 1);\n\n    public static string GetContentPath(string workshopId) =>\n        Path.Combine(SteamCmdDir, \"steamapps\", \"workshop\", \"content\", AppId, workshopId);\n\n    public static async Task EnsureSteamCmdAsync(Action<string> log)\n    {\n        if (File.Exists(SteamCmdExe)) return;\n\n        log(\"SteamCMD not found — downloading it (one-time setup, ~5 MB)...\");\n        Directory.CreateDirectory(SteamCmdDir);\n\n        using var http = new HttpClient();\n        var data = await http.GetByteArrayAsync(SteamCmdZipUrl);\n        var zipPath = Path.Combine(SteamCmdDir, \"steamcmd.zip\");\n        await File.WriteAllBytesAsync(zipPath, data);\n        ZipFile.ExtractToDirectory(zipPath, SteamCmdDir, overwriteFiles: true);\n        File.Delete(zipPath);\n\n        if (!File.Exists(SteamCmdExe))\n            throw new Exception(\"SteamCMD download finished but steamcmd.exe was not found.\");\n\n        log(\"SteamCMD ready.\");\n    }\n\n    private static async Task<int> RunSteamCmdAsync(IEnumerable<string> args, Action<string> log)\n    {\n        var psi = new ProcessStartInfo\n        {\n            FileName = SteamCmdExe,\n            UseShellExecute = false,\n            RedirectStandardOutput = true,\n            RedirectStandardError = true,\n            CreateNoWindow = true,\n            WorkingDirectory = SteamCmdDir,\n        };\n        foreach (var a in args) psi.ArgumentList.Add(a);\n\n        using var process = new Process { StartInfo = psi, EnableRaisingEvents = true };\n        process.OutputDataReceived += (_, e) => { if (e.Data != null) log(e.Data); };\n        process.ErrorDataReceived += (_, e) => { if (e.Data != null) log(e.Data); };\n\n        process.Start();\n        process.BeginOutputReadLine();\n        process.BeginErrorReadLine();\n        await process.WaitForExitAsync();\n        return process.ExitCode;\n    }\n\n    /// <summary>\n    /// SteamCMD self-updates on first run (and sometimes relaunches itself\n    /// to do so, which can return a nonzero exit code even though\n    /// everything worked). Running a harmless '+quit' once up front absorbs\n    /// that self-update so it doesn't interleave with a real download later.\n    /// </summary>\n    private static async Task BootstrapAsync(Action<string> log)\n    {\n        if (_bootstrapped) return;\n        log(\"Preparing SteamCMD (first-time update check)...\");\n        await RunSteamCmdAsync(new[] { \"+quit\" }, log);\n        _bootstrapped = true;\n    }\n\n    /// <summary>\n    /// Downloads workshopId via SteamCMD, then installs it into destFolder\n    /// using the layout Project Zomboid actually expects for local mods:\n    /// destFolder/&lt;workshopId&gt; &lt;ModFolderName&gt;/&lt;mod files directly&gt;\n    /// (not the raw Steam cache layout, which nests content under\n    /// content/&lt;id&gt;/mods/&lt;ModFolderName&gt;/).\n    ///\n    /// A single workshop item can contain more than one mod folder (some\n    /// \"collection\" style items do), so this can install more than one\n    /// destination folder per item. Returns every folder that was created.\n    /// </summary>\n    public static async Task<List<string>> DownloadModAsync(string workshopId, string destFolder, Action<string> log)\n    {\n        // Serialize downloads -- SteamCMD does not support concurrent instances well.\n        await RunLock.WaitAsync();\n        try\n        {\n            await EnsureSteamCmdAsync(log);\n            await BootstrapAsync(log);\n\n            log($\"Downloading workshop item {workshopId} via SteamCMD...\");\n            var args = new[]\n            {\n                \"+force_install_dir\", SteamCmdDir,\n                \"+login\", \"anonymous\",\n                \"+workshop_download_item\", AppId, workshopId,\n                \"+quit\",\n            };\n            int exitCode = await RunSteamCmdAsync(args, log);\n\n            var downloadedPath = GetContentPath(workshopId);\n            bool hasFiles = Directory.Exists(downloadedPath) &&\n                            Directory.EnumerateFileSystemEntries(downloadedPath).Any();\n\n            if (!hasFiles)\n            {\n                throw new Exception(\n                    $\"SteamCMD did not produce any files for item {workshopId} \" +\n                    $\"(exit code {exitCode}). The item may be invalid, removed, or restricted.\");\n            }\n\n            if (exitCode != 0)\n            {\n                // SteamCMD sometimes self-updates again right after a\n                // successful download and returns a nonzero code from that\n                // unrelated relaunch. Since the files are present, treat\n                // this as benign.\n                log($\"Note: SteamCMD returned exit code {exitCode}, but the mod files \" +\n                    $\"were found on disk — continuing.\");\n            }\n\n            var installedPaths = new List<string>();\n            var modsSubdir = Path.Combine(downloadedPath, \"mods\");\n\n            if (Directory.Exists(modsSubdir) && Directory.GetDirectories(modsSubdir).Length > 0)\n            {\n                // Normal case: PZ workshop items ship their actual mod\n                // folder(s) under a \"mods\" subfolder.\n                foreach (var modDir in Directory.GetDirectories(modsSubdir))\n                {\n                    var rawFolderName = Path.GetFileName(modDir);\n                    // Prefer mod.info's \"name=\" (the human-readable display\n                    // name) over the raw subfolder name -- mod authors very\n                    // commonly name that physical folder after their internal\n                    // \"id=\" instead, which produces cryptic, non-descriptive\n                    // installed folder names otherwise.\n                    var modFolderName = GetModDisplayName(modDir) ?? rawFolderName;\n                    var dest = Path.Combine(destFolder, $\"{workshopId} {modFolderName}\");\n                    if (Directory.Exists(dest)) Directory.Delete(dest, recursive: true);\n                    CopyDirectory(modDir, dest);\n                    installedPaths.Add(dest);\n                    log($\"Installed mod to {dest}\");\n                }\n            }\n            else\n            {\n                // Fallback for oddly-structured items with no \"mods\" folder --\n                // install the whole downloaded item as-is.\n                var dest = Path.Combine(destFolder, workshopId);\n                if (Directory.Exists(dest)) Directory.Delete(dest, recursive: true);\n                CopyDirectory(downloadedPath, dest);\n                installedPaths.Add(dest);\n                log($\"Note: no 'mods' subfolder found in this item; installed raw content to {dest}\");\n            }\n\n            return installedPaths;\n        }\n        finally\n        {\n            RunLock.Release();\n        }\n    }\n\n    /// <summary>\n    /// Reads mod.info inside a mod folder and returns its \"name=\" value\n    /// (sanitized for use as a filesystem folder name), or null if there's\n    /// no mod.info or no name field.\n    /// </summary>\n    private static string? GetModDisplayName(string modDir)\n    {\n        try\n        {\n            var infoPath = Path.Combine(modDir, \"mod.info\");\n            if (!File.Exists(infoPath)) return null;\n\n            foreach (var line in File.ReadAllLines(infoPath))\n            {\n                var m = Regex.Match(line.Trim(), @\"^name\\s*=\\s*(.+)$\", RegexOptions.IgnoreCase);\n                if (m.Success)\n                {\n                    var name = m.Groups[1].Value.Trim();\n                    if (!string.IsNullOrWhiteSpace(name))\n                        return SanitizeFileName(name);\n                }\n            }\n        }\n        catch\n        {\n            // Unreadable mod.info -- fall back to the raw folder name.\n        }\n        return null;\n    }\n\n    /// <summary>\n    /// Reads mod.info inside a mod folder and returns every value declared in\n    /// its require= entries. Values are either a numeric workshop id or an\n    /// internal mod identifier (often backslash-prefixed, e.g. \"\\NeatUI_Framework\");\n    /// the backslash prefix and any comma/semicolon separation are stripped.\n    /// Returns an empty list when there is no readable mod.info / no require field.\n    /// </summary>\n    public static List<string> GetRequiresFields(string modDir)\n    {\n        var requires = new List<string>();\n        try\n        {\n            var infoPath = Path.Combine(modDir, \"mod.info\");\n            if (!File.Exists(infoPath)) return requires;\n\n            foreach (var line in File.ReadAllLines(infoPath))\n            {\n                var m = Regex.Match(line.Trim(), @\"^require\\s*=\\s*(.+)$\", RegexOptions.IgnoreCase);\n                if (!m.Success) continue;\n\n                var value = m.Groups[1].Value.Trim();\n                if (string.IsNullOrWhiteSpace(value)) continue;\n\n                foreach (var part in value.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))\n                {\n                    var id = part.Trim();\n                    if (id.StartsWith(\"\\\\\")) id = id[1..].Trim();\n                    if (id.Length > 0) requires.Add(id);\n                }\n            }\n        }\n        catch\n        {\n            // Unreadable mod.info -- no dependencies can be declared.\n        }\n        return requires;\n    }\n\n    /// <summary>\n    /// Reads mod.info inside a mod folder and returns its declared identifier\n    /// values (the letter-based \"id=\" and the human-readable \"name=\"). These are\n    /// used ONLY to resolve a require= reference (e.g. \"\\NeatUI_Framework\") to the\n    /// real workshop id of an installed mod -- never to identify a mod on its own.\n    /// </summary>\n    public static List<string> GetModIdentifiers(string modDir)\n    {\n        var ids = new List<string>();\n        try\n        {\n            var infoPath = Path.Combine(modDir, \"mod.info\");\n            if (!File.Exists(infoPath)) return ids;\n\n            foreach (var line in File.ReadAllLines(infoPath))\n            {\n                var m = Regex.Match(line.Trim(), @\"^(id|name)\\s*=\\s*(.+)$\", RegexOptions.IgnoreCase);\n                if (m.Success && !string.IsNullOrWhiteSpace(m.Groups[2].Value))\n                    ids.Add(m.Groups[2].Value.Trim());\n            }\n        }\n        catch\n        {\n            // Unreadable mod.info -- no identifiers to match against.\n        }\n        return ids;\n    }\n\n    private static string SanitizeFileName(string name)\n    {\n        foreach (var c in Path.GetInvalidFileNameChars())\n            name = name.Replace(c, '_');\n        return name;\n    }\n\n    private static void CopyDirectory(string sourceDir, string destDir)\n    {\n        Directory.CreateDirectory(destDir);\n        foreach (var file in Directory.GetFiles(sourceDir))\n            File.Copy(file, Path.Combine(destDir, Path.GetFileName(file)), overwrite: true);\n        foreach (var dir in Directory.GetDirectories(sourceDir))\n            CopyDirectory(dir, Path.Combine(destDir, Path.GetFileName(dir)));\n    }\n}",
