   /// </summary>\n    public static string GetContentCachePath() =>\n        Path.Combine(SteamCmdDir, \"steamapps\", \"workshop\", \"content\", AppId);\n```\n\nAnd:\n\n```csharp\n    /// <summary>\n    /// Deletes the SteamCMD workshop content cache for Project Zomboid.\n    /// Runs on a background thread so large caches don't freeze the UI.\n    /// Returns the number of bytes of content that was removed (0 when the\n    /// cache was empty or did not exist). Throws if the folder could not be\n    /// deleted, e.g. because SteamCMD is mid-download.\n    /// </summary>\n    public static async Task<long> ClearContentCacheAsync(Action<string> log)\n    {\n        var path = GetContentCachePath();\n\n        if (!Directory.Exists(path))\n        {\n            log(\"No cached workshop content found -- nothing to clear.\");\n            return 0;\n        }\n\n        log(\"Clearing SteamCMD workshop content cache (cached mod files only; SteamCMD itself is kept)...\");\n        long freed = await Task.Run(() =>\n        {\n            long size = GetDirectorySizeBytes(path);\n            Directory.Delete(path, recursive: true);\n            return size;\n        });\n\n        double mb = freed / 1024.0 / 1024.0;\n        log($\"Cleared {mb:0.###} MB of cached workshop content.\");\n        return freed;\n    }\n```\n\nAnd the helper:\n\n```csharp\n    private static long GetDirectorySizeBytes(string path)\n    {\n        long total = 0;\n        try\n        {\n            foreach (var f in Directory.EnumerateFiles(path, \"*\", SearchOption.AllDirectories))\n                total += new FileInfo(f).Length;\n        }\n        catch { /* inaccessible files don't matter here */ }\n        return total;\n    }\n```\n\nEdit 2 — MainWindow XAML settings section. Insert after the Options checkboxes (after the DebugLoggingCheckbox line 751, before the \"Theme\" textblock). New section:\n\n```xml\n                <TextBlock Text=\"SteamCMD Cache\" Foreground=\"{DynamicReso