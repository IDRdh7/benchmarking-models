                "text": "using System;\nusing System.IO;\nusing System.Net.Http;\nusing System.Threading.Tasks;\n\nnamespace PZWorkshopDownloader.Services;\n\n/// <summary>\n/// Local thumbnail cache. Thumbnails are stored as \"&lt;workshopId&gt;.jpg\"\n/// under %LOCALAPPDATA%\\PZWorkshopDownloader\\thumbnails\\ and are reused across\n/// runs, so only genuinely missing images get re-downloaded.\n/// </summary>\npublic static class ThumbnailStore\n{\n    private static readonly HttpClient Http = new();\n\n    public static string CacheDir => Path.Combine(\n        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),\n        \"PZWorkshopDownloader\", \"thumbnails\");\n\n    /// <summary>Path to the cached thumbnail for a workshop id, or \"\" if not cached.</summary>\n    public static string GetCachedPath(string workshopId)\n    {\n        if (string.IsNullOrEmpty(workshopId)) return \"\";\n        var path = Path.Combine(CacheDir, workshopId + \".jpg\");\n        return File.Exists(path) ? path : \"\";\n    }\n\n    /// <summary>\n    /// Downloads a thumbnail into the cache. Returns the local path on success,\n    /// or \"\" if the download failed (callers then fall back to a placeholder).\n    /// Never throws.\n    /// </summary>\n    public static async Task<string> DownloadAsync(string workshopId, string previewUrl)\n    {\n        if (string.IsNullOrEmpty(workshopId) || string.IsNullOrEmpty(previewUrl)) return \"\";\n        try\n        {\n            Directory.CreateDirectory(CacheDir);\n            var bytes = await Http.GetByteArrayAsync(previewUrl);\n            if (bytes.Length == 0) return \"\";\n            var path = Path.Combine(CacheDir, workshopId + \".jpg\");\n            await File.WriteAllBytesAsync(path, bytes);\n            return path;\n        }\n        catch\n        {\n            return \"\";\n        }\n    }\n\n    /// <summary>Cache path if already present, otherwise downloads and returns it (or \"\" on failure).</summary>\n    public static async Task<string> GetOrDownloadAsync(string workshopId, string previewUrl)\n    {\n        var cached = GetCachedPath(workshopId);\n        if (cached.Length > 0) return cached;\n        return await DownloadAsync(workshopId, previewUrl);\n    }\n}",
