                "text": "using System;\nusing System.Collections.Generic;\nusing System.Collections.ObjectModel;\nusing System.Diagnostics;\nusing System.IO;\nusing System.Linq;\nusing System.Text.RegularExpressions;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing System.Windows;\nusing System.Windows.Controls;\nusing System.Windows.Controls.Primitives;\nusing System.Windows.Data;\nusing System.Windows.Input;\nusing System.Windows.Media;\nusing System.Windows.Media.Animation;\nusing System.Xml.Linq;\nusing PZWorkshopDownloader.Models;\nusing PZWorkshopDownloader.Services;\n\nnamespace PZWorkshopDownloader;\n\npublic partial class MainWindow : Window\n{\n    private const string WorkshopHomeUrl =\n        \"https://steamcommunity.com/workshop/browse/?appid=\" + SteamCmdService.AppId +\n        \"&browsesort=trend&section=readytouseitems\";\n\n    private readonly AppSettings _settings;\n    private readonly ObservableCollection<QueueItem> _queue = new();\n    private readonly ObservableCollection<ModRecord> _downloadedMods = new();\n    private readonly ObservableCollection<DownloadTask> _downloads = new();\n    private readonly ObservableCollection<UninstalledModEntry> _uninstalledMods = new();\n\n    // Per-session cache of \"Show Deps\" Workshop-page lookups (workshopId ->\n    // parsed required items), so re-opening the popup for the same mod doesn't\n    // re-download the page. The in-flight set prevents duplicate simultaneous\n    // fetches if the button is clicked repeatedly.\n    private readonly Dictionary<string, List<WorkshopRequiredItem>> _depsPageCache = new();\n    private readonly HashSet<string> _depsFetchInFlight = new();\n\n    // ================= Batch 4: visual subsystem =================\n    // Currently selected tag filters for the Installed Mods sidebar.\n    private readonly HashSet<string> _selectedTags = new(StringComparer.OrdinalIgnoreCase);\n\n    // Guards the thumbnail download fan-out so a large mod list doesn't\n    // hammer the CDN with hundreds of concurrent requests.\n    private static readonly SemaphoreSlim ThumbnailGate = new(4);\n\n    private bool _tagSidebarExpanded = true;\n\n    public MainWindow()\n    {\n        InitializeComponent();\n\n        _settings = SettingsService.Load();\n\n        QueueList.ItemsSource = _queue;\n        _queue.CollectionChanged += (_, _) => UpdateQueuePanelVisibility();\n        UpdateQueuePanelVisibility();\n        DownloadedModsGrid.ItemsSource = _downloadedMods;\n        foreach (var e in DownloadHistoryStore.Load())\n        {\n            _downloads.Add(new DownloadTask\n            {\n                Id = e.Id,\n                Title = e.Title,\n                Status = e.Status,\n                Detail = e.Detail,\n                StartedAt = e.StartedAt,\n                FinishedAt = e.FinishedAt,\n            });\n        }\n        DownloadsGrid.ItemsSource = _downloads;\n\n        foreach (var entry in UninstalledModsStore.Load()) _uninstalledMods.Add(entry);\n        UninstalledModsGrid.ItemsSource = _uninstalledMods;\n\n        LogList.ItemsSource = _logEntries;\n\n        // Batch 4: default tile size and shared views. Tiles bind to the same\n        // collections as the grids, so the tag filter applies to both.\n        Application.Current.Resources[\"ModTileSize\"] = 140d;\n        InstalledTiles.ItemsSource = _downloadedMods;\n        DownloadsTiles.ItemsSource = _downloads;\n        UninstalledTiles.ItemsSource = _uninstalledMods;\n\n        // Fetch previews/tags + thumbnails for history and uninstalled lists\n        // in the background; the grid/tile placeholders fill in as they arrive.\n        _ = LoadDownloadsThumbnailsAsync();\n        _ = LoadUninstalledThumbnailsAsync();\n\n        PzFolderBox.Text = _settings.ModsFolder;\n        DestFolderLabel.Text = string.IsNullOrWhiteSpace(_settings.ModsFolder) ? \"Not set\" : _settings.ModsFolder;\n        BackupCheckbox.IsChecked = _settings.BackupUpdatedMods;\n        AutoRefreshCheckbox.IsChecked = _settings.AutoRefreshOnTabSwitch;\n        DebugLoggingCheckbox.IsChecked = _settings.DebugLogging;\n        ThemeCombo.SelectedIndex = _settings.Theme switch\n        {\n            \"Light\" => 0,\n            \"Dark\" => 1,\n            \"Midnight\" => 2,\n            \"Forest\" => 3,\n            \"Nord\" => 4,\n            \"Dracula\" => 5,\n            \"Solarized Dark\" => 6,\n            \"Solarized Light\" => 7,\n            \"Gruvbox\" => 8,\n            \"Monokai\" => 9,\n            _ => 1,\n        };\n        ApplyTheme(_settings.Theme);\n\n        ApplyUiFontSizes();\n\n        Browser.SourceChanged += (_, _) => AddressBar.Text = Browser.Source?.ToString() ?? \"\";\n        MainTabs.SelectionChanged += MainTabs_SelectionChanged;\n\n        Loaded += MainWindow_Loaded;\n    }\n\n    private void MainTabs_SelectionChanged(object sender, System.Windows.Controls.SelectionChangedEventArgs e)\n    {\n        if (_settings.AutoRefreshOnTabSwitch && MainTabs.SelectedItem == InstalledModsTabItem)\n            _ = RefreshDownloadedModsAsync();\n    }\n\n    private async void MainWindow_Loaded(object sender, RoutedEventArgs e)\n    {\n        AppendLog(\"Application started.\");\n        try\n        {\n            await Browser.EnsureCoreWebView2Async();\n        }\n        catch (Exception ex)\n        {\n            MessageBox.Show(\n                \"Could not start the embedded browser (WebView2). Make sure the \" +\n                \"WebView2 Runtime is installed.\\n\\n\" + ex.Message,\n                \"Browser init failed\", MessageBoxButton.OK, MessageBoxImage.Warning);\n            AppendLog($\"Browser init failed: {ex.Message}\");\n        }\n\n        await RefreshDownloadedModsAsync();\n    }\n\n    // ================= Bottom log panel =================\n\n    private readonly ObservableCollection<LogEntry> _logEntries = new();\n    private bool _logExpanded = false;\n\n    private void ToggleLog_Click(object sender, RoutedEventArgs e)\n    {\n        _logExpanded = !_logExpanded;\n        LogToggle.Content = _logExpanded ? \"Hide Log \\u25BC\" : \"Show Log \\u25B2\";\n\n        var anim = new DoubleAnimation\n        {\n            To = _logExpanded ? 260 : 0,\n            Duration = TimeSpan.FromMilliseconds(220),\n            EasingFunction = new QuadraticEase { EasingMode = EasingMode.EaseInOut },\n        };\n        LogPanelBorder.BeginAnimation(HeightProperty, anim);\n    }\n\n    private void ClearLogButton_Click(object sender, RoutedEventArgs e)\n    {\n        _logEntries.Clear();\n        JumpToBottomButton.Visibility = Visibility.Collapsed;\n    }\n\n    private void JumpToBottomButton_Click(object sender, RoutedEventArgs e)\n    {\n        if (_logEntries.Count > 0) LogList.ScrollIntoView(_logEntries[_logEntries.Count - 1]);\n        JumpToBottomButton.Visibility = Visibility.Collapsed;\n    }\n\n    private bool IsLogAtBottom()\n    {\n        var sv = FindScrollViewer(LogList);\n        if (sv == null) return true; // not rendered yet -- default to following\n        return sv.ScrollableHeight <= 0 || sv.VerticalOffset >= sv.ScrollableHeight - 4;\n    }\n\n    private static ScrollViewer? FindScrollViewer(DependencyObject d)\n    {\n        for (int i = 0; i < VisualTreeHelper.GetChildrenCount(d); i++)\n        {\n            var child = VisualTreeHelper.GetChild(d, i);\n            if (child is ScrollViewer sv) return sv;\n            var result = FindScrollViewer(child);\n            if (result != null) return result;\n        }\n        return null;\n    }\n\n    /// <summary>\n    /// Appends a timestamped line to the in-app log panel so backend\n    /// activity is visible without digging through any log file. Safe to\n    /// call from any thread. DEBUG-level lines (raw, high-volume SteamCMD\n    /// output) are skipped unless the debug logging setting is on. Only\n    /// auto-scrolls if the user was already at the bottom -- otherwise a\n    /// \"Jump to Bottom\" button appears instead of yanking their view.\n    /// </summary>\n    private void AppendLog(string message, string level = \"INFO\")\n    {\n        if (level == \"DEBUG\" && !_settings.DebugLogging) return;\n\n        void Do()\n        {\n            bool wasAtBottom = IsLogAtBottom();\n\n            _logEntries.Add(new LogEntry\n            {\n                Time = DateTime.Now.ToString(\"HH:mm:ss\"),\n                Level = level,\n                Message = message,\n            });\n            while (_logEntries.Count > 500) _logEntries.RemoveAt(0);\n\n            if (wasAtBottom)\n            {\n                LogList.UpdateLayout();\n                if (_logEntries.Count > 0) LogList.ScrollIntoView(_logEntries[_logEntries.Count - 1]);\n                JumpToBottomButton.Visibility = Visibility.Collapsed;\n            }\n            else\n            {\n                JumpToBottomButton.Visibility = Visibility.Visible;\n            }\n        }\n\n        if (Dispatcher.CheckAccess()) Do();\n        else Dispatcher.Invoke(Do);\n    }\n\n    // ================= Downloader tab: navigation =================\n\n    private void Back_Click(object sender, RoutedEventArgs e)\n    {\n        if (Browser.CanGoBack) Browser.GoBack();\n    }\n\n    private void Forward_Click(object sender, RoutedEventArgs e)\n    {\n        if (Browser.CanGoForward) Browser.GoForward();\n    }\n\n    private void Home_Click(object sender, RoutedEventArgs e) => Navigate(WorkshopHomeUrl);\n\n    private void AddressBar_KeyDown(object sender, KeyEventArgs e)\n    {\n        if (e.Key == Key.Enter) Navigate(AddressBar.Text);\n    }\n\n    private void Navigate(string input)\n    {\n        input = input.Trim();\n        if (string.IsNullOrEmpty(input)) return;\n\n        string url = Regex.IsMatch(input, \"^https?://\", RegexOptions.IgnoreCase)\n            ? input\n            : $\"https://steamcommunity.com/workshop/browse/?appid={SteamCmdService.AppId}&searchtext={Uri.EscapeDataString(input)}\";\n\n        if (Browser.CoreWebView2 != null)\n            Browser.CoreWebView2.Navigate(url);\n        else\n            Browser.Source = new Uri(url);\n    }\n\n    private string? GetCurrentWorkshopId()\n    {\n        var url = Browser.Source?.ToString() ?? \"\";\n        var m = Regex.Match(url, @\"[?&]id=(\\d+)\");\n        return m.Success ? m.Groups[1].Value : null;\n    }\n\n    private string GetCurrentTitle()\n    {\n        var t = Browser.CoreWebView2?.DocumentTitle ?? \"\";\n        var idx = t.IndexOf(\"::\", StringComparison.Ordinal);\n        return (idx >= 0 ? t[(idx + 2)..] : t).Trim();\n    }\n\n    // ================= Downloader tab: download actions =================\n\n    private void PickModsFolder()\n    {\n        var dlg = new Microsoft.Win32.OpenFolderDialog\n        {\n            InitialDirectory = string.IsNullOrWhiteSpace(_settings.ModsFolder) ? null : _settings.ModsFolder,\n        };\n        if (dlg.ShowDialog() == true)\n        {\n            _settings.ModsFolder = dlg.FolderName;\n            SettingsService.Save(_settings);\n            DestFolderLabel.Text = _settings.ModsFolder;\n            PzFolderBox.Text = _settings.ModsFolder;\n            AppendLog($\"Mods folder set to: {_settings.ModsFolder}\");\n            _ = RefreshDownloadedModsAsync();\n        }\n    }\n\n    private async void DownloadCurrent_Click(object sender, RoutedEventArgs e)\n    {\n        var id = GetCurrentWorkshopId();\n        if (id == null)\n        {\n            MessageBox.Show(\"Open a specific Workshop item page first (click into a mod from the list).\");\n            return;\n        }\n        await StartDownloadAsync(id, GetCurrentTitle());\n    }\n\n    private void AddToQueue_Click(object sender, RoutedEventArgs e)\n    {\n        var id = GetCurrentWorkshopId();\n        if (id == null)\n        {\n            MessageBox.Show(\"Open a specific Workshop item page first (click into a mod from the list).\");\n            return;\n        }\n        if (_queue.Any(q => q.Id == id)) return;\n        _queue.Add(new QueueItem { Id = id, Title = GetCurrentTitle(), Status = \"Queued\" });\n    }\n\n    private void ClearQueue_Click(object sender, RoutedEventArgs e) => _queue.Clear();\n\n    /// <summary>\n    /// The queue panel is window-level (right side of every tab). It stays\n    /// hidden while the queue is empty and appears automatically as soon as a\n    /// mod is queued, disappearing again once the queue is cleared.\n    /// </summary>\n    private void UpdateQueuePanelVisibility()\n    {\n        bool hasItems = _queue.Count > 0;\n        QueuePanel.Visibility = hasItems ? Visibility.Visible : Visibility.Collapsed;\n        QueueColumn.Width = hasItems ? new GridLength(280) : new GridLength(0);\n    }\n\n    private async void StartQueue_Click(object sender, RoutedEventArgs e)\n    {\n        if (string.IsNullOrWhiteSpace(_settings.ModsFolder))\n        {\n            MessageBox.Show(\"Choose a destination folder first.\");\n            return;\n        }\n        foreach (var item in _queue.ToList())\n        {\n            item.Status = \"Downloading...\";\n            var ok = await StartDownloadAsync(item.Id, item.Title, showFolderWarning: false);\n            item.Status = ok ? \"Done\" : \"Failed\";\n        }\n        StatusText.Text = \"Queue finished.\";\n        AppendLog(\"Download queue finished.\");\n    }\n\n    /// <summary>Returns true on success.</summary>\n    private async Task<bool> StartDownloadAsync(string id, string title, bool showFolderWarning = true)\n    {\n        if (string.IsNullOrWhiteSpace(_settings.ModsFolder))\n        {\n            if (showFolderWarning) MessageBox.Show(\"Choose a destination folder first.\");\n            return false;\n        }\n\n        var task = new DownloadTask\n        {\n            Id = id,\n            Title = title,\n            Status = \"Downloading\",\n            StartedAt = DateTime.Now.ToString(\"h:mm:ss tt\"),\n        };\n        _downloads.Insert(0, task);\n        SaveDownloadHistory();\n\n        // Batch 4: fetch this mod's preview thumbnail in the background so the\n        // Downloads tab shows it even before a full history reload.\n        _ = FetchTaskThumbnailAsync(task);\n\n        StatusText.Text = $\"Downloading {title}...\";\n        AppendLog($\"Starting download: {title} ({id})\");\n        ProgressBarCtl.IsIndeterminate = true;\n        try\n        {\n            var installedPaths = await SteamCmdService.DownloadModAsync(id, _settings.ModsFolder, line =>\n            {\n                // SteamCMD's output arrives on a background thread.\n                Dispatcher.Invoke(() => task.Detail = line);\n                AppendLog(line, \"DEBUG\");\n            });\n\n            // Record the content manifest id (not a date) as the \"version\"\n            // we now have locally, so future update-checks compare like for like.\n            try\n            {\n                var details = await WorkshopApiService.GetDetailsAsync(id);\n                _settings.LocalModVersions[id] = details.ContentManifestId;\n                _settings.InstallDates[id] = DateTimeOffset.Now.ToString(\"dd-MMM-yy h:mm:ss tt\");\n            }\n            catch\n            {\n                // Offline right after downloading -- leave whatever version\n                // was previously recorded (or none) rather than fail the download.\n            }\n            SettingsService.Save(_settings);\n\n            task.Status = \"Done\";\n            task.FinishedAt = DateTime.Now.ToString(\"h:mm:ss tt\");\n            task.Detail = installedPaths.Count == 1\n                ? $\"Installed to \\\"{Path.GetFileName(installedPaths[0])}\\\"\"\n                : $\"{installedPaths.Count} mod folders installed\";\n\n            StatusText.Text = installedPaths.Count == 1\n                ? $\"Done: {title}\"\n                : $\"Done: {title} ({installedPaths.Count} mod folders installed)\";\n            AppendLog($\"Finished: {title} \\u2714 ({installedPaths.Count} folder(s))\");\n            SaveDownloadHistory();\n            await RefreshDownloadedModsAsync();\n            return true;\n        }\n        catch (Exception ex)\n        {\n            task.Status = \"Failed\";\n            task.FinishedAt = DateTime.Now.ToString(\"h:mm:ss tt\");\n            task.Detail = ex.Message;\n            StatusText.Text = $\"Failed: {title} — {ex.Message}\";\n            AppendLog($\"FAILED: {title} — {ex.Message}\", \"ERROR\");\n            SaveDownloadHistory();\n            return false;\n        }\n        finally\n        {\n            ProgressBarCtl.IsIndeterminate = false;\n        }\n    }\n\n    private void ClearFinishedDownloads_Click(object sender, RoutedEventArgs e)\n    {\n        foreach (var t in _downloads.Where(t => t.Status is \"Done\" or \"Failed\").ToList())\n            _downloads.Remove(t);\n        SaveDownloadHistory();\n    }\n\n    private void ClearAllDownloads_Click(object sender, RoutedEventArgs e)\n    {\n        _downloads.Clear();\n        SaveDownloadHistory();\n    }\n\n    private void RemoveDownloadEntry_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is FrameworkElement fe && fe.Tag is DownloadTask task)\n        {\n            _downloads.Remove(task);\n            SaveDownloadHistory();\n        }\n    }\n\n    private void SaveDownloadHistory()\n    {\n        var entries = _downloads.Select(t => new DownloadHistoryEntry\n        {\n            Id = t.Id,\n            Title = t.Title,\n            Status = t.Status,\n            Detail = t.Detail,\n            StartedAt = t.StartedAt,\n            FinishedAt = t.FinishedAt,\n        }).ToList();\n        DownloadHistoryStore.Save(entries);\n    }\n\n    /// <summary>\n    /// Figures out which Steam Workshop id a local mod folder corresponds to.\n    /// Tries the \"&lt;id&gt; &lt;name&gt;\" naming convention this app installs mods\n    /// under first, then falls back to scanning any mod.info file inside for\n    /// a purely-numeric id= line (some mods happen to use one).\n    /// </summary>\n    private static bool TryExtractWorkshopId(string folderPath, out string id)\n    {\n        id = \"\";\n        var name = Path.GetFileName(folderPath);\n        if (name.StartsWith(\"_\")) return false; // skip internal folders like _backups\n\n        var m = Regex.Match(name, @\"^(\\d+)\");\n        if (m.Success)\n        {\n            id = m.Groups[1].Value;\n            return true;\n        }\n\n        try\n        {\n            foreach (var infoFile in Directory.EnumerateFiles(folderPath, \"mod.info\", SearchOption.AllDirectories))\n            {\n                foreach (var line in File.ReadAllLines(infoFile))\n                {\n                    var lm = Regex.Match(line.Trim(), @\"^id\\s*=\\s*(\\d+)\\s*$\", RegexOptions.IgnoreCase);\n                    if (lm.Success)\n                    {\n                        id = lm.Groups[1].Value;\n                        return true;\n                    }\n                }\n            }\n        }\n        catch\n        {\n            // Unreadable folder -- treat as unresolvable.\n        }\n\n        return false;\n    }\n\n    /// <summary>\n    /// Normalizes a mod identifier for dependency matching: lowercase, remove\n    /// spaces and punctuation, so \"NeatUI_Framework\" == \"neatui framework\" ==\n    /// \"NeatUI Framework\" when comparing require= values against installed\n    /// mods' id=/name= fields.\n    /// </summary>\n    private static string NormalizeModIdentifier(string value)\n    {\n        var sb = new System.Text.StringBuilder(value.Length);\n        foreach (var c in value)\n        {\n            if (char.IsLetterOrDigit(c)) sb.Append(char.ToLowerInvariant(c));\n        }\n        return sb.ToString();\n    }\n\n    // ================= Downloaded Mods tab =================\n\n    private async void RefreshDownloadedMods_Click(object sender, RoutedEventArgs e) =>\n        await RefreshDownloadedModsAsync();\n\n    private void ExportModList_Click(object sender, RoutedEventArgs e)\n    {\n        if (_downloadedMods.Count == 0)\n        {\n            MessageBox.Show(\"No installed mods to export yet. Try 'Refresh Mod List' first.\");\n            return;\n        }\n\n        var dlg = new Microsoft.Win32.SaveFileDialog\n        {\n            Filter = \"XML files (*.xml)|*.xml\",\n            FileName = \"pz_mod_list.xml\",\n        };\n        if (dlg.ShowDialog() != true) return;\n\n        try\n        {\n            var root = new XElement(\"ModList\",\n                _downloadedMods.Select(m => new XElement(\"Mod\",\n                    new XElement(\"Name\", m.ModName),\n                    new XElement(\"WorkshopID\", m.Id),\n                    new XElement(\"Author\", m.Creator),\n                    new XElement(\"Link\", $\"https://steamcommunity.com/sharedfiles/filedetails/?id={m.Id}\"))));\n            new XDocument(root).Save(dlg.FileName);\n\n            AppendLog($\"Exported {_downloadedMods.Count} mod(s) to {dlg.FileName}\");\n            StatusText.Text = \"Mod list exported.\";\n        }\n        catch (Exception ex)\n        {\n            MessageBox.Show($\"Could not save file: {ex.Message}\");\n            AppendLog($\"Export failed: {ex.Message}\", \"ERROR\");\n        }\n    }\n\n    private void ImportModList_Click(object sender, RoutedEventArgs e)\n    {\n        var dlg = new Microsoft.Win32.OpenFileDialog { Filter = \"XML files (*.xml)|*.xml\" };\n        if (dlg.ShowDialog() != true) return;\n\n        XDocument doc;\n        try\n        {\n            doc = XDocument.Load(dlg.FileName);\n        }\n        catch (Exception ex)\n        {\n            MessageBox.Show($\"Could not read XML file: {ex.Message}\");\n            AppendLog($\"Import failed: {ex.Message}\", \"ERROR\");\n            return;\n        }\n\n        var installedIds = _downloadedMods.Select(m => m.Id).ToHashSet();\n        int added = 0, skipped = 0;\n\n        foreach (var modEl in doc.Root?.Elements(\"Mod\") ?? Enumerable.Empty<XElement>())\n        {\n            var id = modEl.Element(\"WorkshopID\")?.Value?.Trim();\n            var name = modEl.Element(\"Name\")?.Value?.Trim();\n            if (string.IsNullOrEmpty(id)) continue;\n\n            if (installedIds.Contains(id) || _queue.Any(q => q.Id == id))\n            {\n                skipped++;\n                continue;\n            }\n\n            _queue.Add(new QueueItem { Id = id, Title = string.IsNullOrEmpty(name) ? id : name, Status = \"Queued\" });\n            added++;\n        }\n\n        AppendLog($\"Imported mod list from {dlg.FileName}: {added} added to queue, {skipped} skipped (already installed or queued).\");\n        MessageBox.Show(\n            $\"{added} mod(s) added to the download queue.\\n{skipped} were already installed or queued and skipped.\\n\\n\" +\n            \"Switch to the Browser tab and click 'Start Downloading All' in the queue panel to fetch them.\",\n            \"Import Complete\");\n    }\n\n    /// <summary>\n    /// Scans the mods folder, pulls live details from Steam for each mod,\n    /// and determines which ones need an update -- this single pass now\n    /// covers both \"list what's installed\" and \"check for updates\" (the\n    /// tabs used to be separate; merged so there's one source of truth).\n    /// </summary>\n    private async Task RefreshDownloadedModsAsync()\n    {\n        if (string.IsNullOrWhiteSpace(_settings.ModsFolder) || !Directory.Exists(_settings.ModsFolder))\n            return;\n\n        AppendLog(\"Refreshing mod list and checking for updates...\");\n        var records = new List<ModRecord>();\n        int updatesAvailable = 0;\n\n        // Build an index of every installed mod's declared identifiers (id=/name=\n        // from its mod.info) -> real workshop id (the numeric folder prefix), plus\n        // the set of installed workshop ids. This lets require= entries (numeric\n        // ids or internal names like \"\\NeatUI_Framework\") be resolved purely\n        // against what is already on disk -- no extra Steam API calls.\n        var installedWorkshopIds = new HashSet<string>(StringComparer.Ordinal);\n        var identifierIndex = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);\n        foreach (var dir in Directory.GetDirectories(_settings.ModsFolder))\n        {\n            if (!TryExtractWorkshopId(dir, out var knownId)) continue;\n            installedWorkshopIds.Add(knownId);\n            foreach (var ident in SteamCmdService.GetModIdentifiers(dir))\n            {\n                var key = NormalizeModIdentifier(ident);\n                if (key.Length > 0) identifierIndex.TryAdd(key, knownId);\n            }\n        }\n\n        foreach (var dir in Directory.GetDirectories(_settings.ModsFolder))\n        {\n            if (!TryExtractWorkshopId(dir, out var id)) continue;\n            var folderName = Path.GetFileName(dir);\n\n            // Resolve require= entries against the installed-mod index above.\n            var requires = SteamCmdService.GetRequiresFields(dir);\n            var missingDeps = new List<string>();\n            foreach (var req in requires)\n            {\n                bool met = long.TryParse(req, out _)\n                    ? installedWorkshopIds.Contains(req)\n                    : identifierIndex.TryGetValue(NormalizeModIdentifier(req), out _);\n                if (!met) missingDeps.Add(req);\n            }\n\n            string title = folderName, posted = \"\", updated = \"\", steamVer = \"Unknown\", creator = \"\";\n            bool resolvedRemote = false;\n            try\n            {\n                var details = await WorkshopApiService.GetDetailsAsync(id);\n                title = details.Title;\n                posted = details.TimeCreated == default ? \"\" : details.TimeCreated.ToLocalTime().ToString(\"dd-MMM-yy h:mm:ss tt\");\n                updated = details.TimeUpdated == default ? \"\" : details.TimeUpdated.ToLocalTime().ToString(\"dd-MMM-yy h:mm:ss tt\");\n                steamVer = string.IsNullOrEmpty(details.ContentManifestId) ? \"Unknown\" : details.ContentManifestId;\n                resolvedRemote = !string.IsNullOrEmpty(details.ContentManifestId);\n                creator = details.Creator;\n            }\n            catch\n            {\n                // Offline, or the item was removed -- still show the folder by id.\n            }\n\n            var hasLocalVersion = _settings.LocalModVersions.TryGetValue(id, out var lv) && !string.IsNullOrEmpty(lv);\n            var localVer = hasLocalVersion ? lv! : \"Unknown\";\n            var installDate = _settings.InstallDates.TryGetValue(id, out var idate) ? idate : \"\";\n\n            bool needsUpdate;\n            if (!resolvedRemote)\n                needsUpdate = false; // couldn't reach Steam -- don't false-flag\n            else if (!hasLocalVersion)\n                needsUpdate = true; // never tracked (e.g. placed manually) -- flag so the user can decide\n            else\n                needsUpdate = !string.Equals(lv, steamVer, StringComparison.Ordinal);\n\n            if (needsUpdate) updatesAvailable++;\n\n            records.Add(new ModRecord\n            {\n                Folder = folderName,\n                FullPath = dir,\n                Id = id,\n                ModName = title,\n                Size = FormatSize(GetDirectorySize(dir)),\n                Posted = posted,\n                Updated = updated,\n                LocalVersion = localVer,\n                SteamVersion = steamVer,\n                InstallDate = installDate,\n                NeedsUpdate = needsUpdate,\n                StatusLabel = needsUpdate ? \"Update Available\" : \"Updated\",\n                Creator = creator,\n                Dependencies = requires,\n                MissingDependencies = missingDeps,\n                MissingDepsCount = missingDeps.Count,\n            });\n        }\n\n        _downloadedMods.Clear();\n        foreach (var r in records) _downloadedMods.Add(r);\n\n        UpdatesAvailableText.Text = $\"Mods with updates available: {updatesAvailable}\";\n        UpdateAllButton.IsEnabled = updatesAvailable > 0;\n        AppendLog($\"Refresh complete: {records.Count} mod(s) installed, {updatesAvailable} update(s) available.\");\n\n        // Batch 4: kick off the preview/tag/thumbnail fetch for installed mods\n        // in the background. Tag sidebar + thumbnails fill in as it completes.\n        _ = LoadInstalledVisualsAsync();\n    }\n\n    // ================= Batch 4: visual loading pipeline =================\n\n    /// <summary>\n    /// Fetches preview_url + tags for the installed mods in one batched API\n    /// call, downloads any missing thumbnails into the cache (throttled), then\n    /// rebuilds the tag sidebar. Runs in the background; grids/tiles update in\n    /// place because ThumbnailPath raises PropertyChanged.\n    /// </summary>\n    private async Task LoadInstalledVisualsAsync()\n    {\n        try\n        {\n            var mods = _downloadedMods.ToList();\n            if (mods.Count == 0) { RebuildTagSidebar(); return; }\n\n            var visuals = await WorkshopVisualService.GetVisualsAsync(mods.Select(m => m.Id));\n\n            await Task.WhenAll(mods.Select(async m =>\n            {\n                if (!visuals.TryGetValue(m.Id, out var v)) return;\n                m.Tags = v.Tags;\n                await ThumbnailGate.WaitAsync();\n                try\n                {\n                    m.ThumbnailPath = await ThumbnailStore.GetOrDownloadAsync(m.Id, v.PreviewUrl);\n                }\n                finally\n                {\n                    ThumbnailGate.Release();\n                }\n            }));\n\n            await Dispatcher.InvokeAsync(RebuildTagSidebar);\n            AppendLog($\"Loaded previews/tags for {mods.Count} installed mod(s).\");\n        }\n        catch (Exception ex)\n        {\n            AppendLog($\"Could not load mod visuals: {ex.Message}\", \"WARNING\");\n        }\n    }\n\n    private async Task LoadDownloadsThumbnailsAsync()\n    {\n        try\n        {\n            var tasks = _downloads.Where(t => !string.IsNullOrEmpty(t.Id)).Select(t => t.Id).Distinct().ToList();\n            if (tasks.Count == 0) return;\n            var visuals = await WorkshopVisualService.GetVisualsAsync(tasks);\n\n            await Task.WhenAll(_downloads.Select(async t =>\n            {\n                if (!visuals.TryGetValue(t.Id, out var v)) return;\n                await ThumbnailGate.WaitAsync();\n                try\n                {\n                    t.ThumbnailPath = await ThumbnailStore.GetOrDownloadAsync(t.Id, v.PreviewUrl);\n                }\n                finally\n                {\n                    ThumbnailGate.Release();\n                }\n            }));\n        }\n        catch (Exception ex)\n        {\n            AppendLog($\"Could not load download thumbnails: {ex.Message}\", \"WARNING\");\n        }\n    }\n\n    /// <summary>\n    /// Fetches a single download task's preview thumbnail (used right after a\n    /// new download starts). Never throws.\n    /// </summary>\n    private async Task FetchTaskThumbnailAsync(DownloadTask task)\n    {\n        try\n        {\n            if (string.IsNullOrEmpty(task.Id)) return;\n            var visuals = await WorkshopVisualService.GetVisualsAsync(new[] { task.Id });\n            if (!visuals.TryGetValue(task.Id, out var v)) return;\n            task.ThumbnailPath = await ThumbnailStore.GetOrDownloadAsync(task.Id, v.PreviewUrl);\n        }\n        catch\n        {\n            // Thumbnails are cosmetic; a failure here must never disturb a download.\n        }\n    }\n\n    private async Task LoadUninstalledThumbnailsAsync()\n    {\n        try\n        {\n            var entries = _uninstalledMods.ToList();\n            if (entries.Count == 0) return;\n            var visuals = await WorkshopVisualService.GetVisualsAsync(entries.Select(e => e.Id));\n\n            await Task.WhenAll(entries.Select(async e =>\n            {\n                if (!visuals.TryGetValue(e.Id, out var v)) return;\n                await ThumbnailGate.WaitAsync();\n                try\n                {\n                    e.ThumbnailPath = await ThumbnailStore.GetOrDownloadAsync(e.Id, v.PreviewUrl);\n                }\n                finally\n                {\n                    ThumbnailGate.Release();\n                }\n            }));\n        }\n        catch (Exception ex)\n        {\n            AppendLog($\"Could not load uninstalled-mod thumbnails: {ex.Message}\", \"WARNING\");\n        }\n    }\n\n    // ================= Batch 4: tag filter sidebar =================\n\n    /// <summary>\n    /// Rebuilds the Installed Mods tag sidebar from the union of Steam tags\n    /// across installed mods, preserving whatever filters were already checked.\n    /// </summary>\n    private void RebuildTagSidebar()\n    {\n        var tags = _downloadedMods.SelectMany(m => m.Tags)\n            .Where(t => !string.IsNullOrWhiteSpace(t))\n            .Distinct(StringComparer.OrdinalIgnoreCase)\n            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase)\n            .ToList();\n\n        var kept = _selectedTags.Where(t => tags.Contains(t, StringComparer.OrdinalIgnoreCase)).ToList();\n\n        TagFilterPanel.Children.Clear();\n        foreach (var tag in tags)\n        {\n            var cb = new CheckBox\n            {\n                Content = tag,\n                Tag = tag,\n                IsChecked = kept.Contains(tag, StringComparer.OrdinalIgnoreCase),\n                Margin = new Thickness(0, 2, 0, 2),\n            };\n            cb.SetResourceReference(Control.ForegroundProperty, \"FgText\");\n            cb.Checked += TagFilter_Changed;\n            cb.Unchecked += TagFilter_Changed;\n            TagFilterPanel.Children.Add(cb);\n        }\n\n        TagCountText.Text = $\"{tags.Count} tag(s)\";\n        _selectedTags.Clear();\n        foreach (var t in kept) _selectedTags.Add(t);\n        ApplyInstalledTagFilter();\n    }\n\n    private void TagFilter_Changed(object? sender, RoutedEventArgs e)\n    {\n        if (sender is not CheckBox { Tag: string tag } cb) return;\n        if (cb.IsChecked == true) _selectedTags.Add(tag);\n        else _selectedTags.Remove(tag);\n        ApplyInstalledTagFilter();\n    }\n\n    /// <summary>\n    /// Filters the installed-mod collection through the shared collection view\n    /// so the list grid AND the tile view update together. A mod is shown when\n    /// no filters are selected, or when it matches any selected tag. Mods with\n    /// no tag data stay visible so nothing gets hidden by accident.\n    /// </summary>\n    private void ApplyInstalledTagFilter()\n    {\n        var view = CollectionViewSource.GetDefaultView(_downloadedMods);\n        view.Filter = _selectedTags.Count == 0 ? null :\n            o => o is ModRecord m && (m.Tags.Count == 0 || m.Tags.Any(t => _selectedTags.Contains(t)));\n    }\n\n    private void SelectAllTags_Click(object sender, RoutedEventArgs e)\n    {\n        foreach (var child in TagFilterPanel.Children)\n            if (child is CheckBox cb) cb.IsChecked = true;\n    }\n\n    private void ClearTags_Click(object sender, RoutedEventArgs e)\n    {\n        foreach (var child in TagFilterPanel.Children)\n            if (child is CheckBox cb) cb.IsChecked = false;\n    }\n\n    private void ToggleTagSidebar_Click(object sender, RoutedEventArgs e)\n    {\n        _tagSidebarExpanded = !_tagSidebarExpanded;\n        TagSidebarColumn.Width = _tagSidebarExpanded ? new GridLength(190) : new GridLength(0);\n        TagSidebarToggle.Content = _tagSidebarExpanded ? \"\\u25C0\" : \"\\u25B6\";\n        TagFilterPanel.Visibility = _tagSidebarExpanded ? Visibility.Visible : Visibility.Collapsed;\n    }\n\n    // ================= Batch 4: list/tile view toggles =================\n\n    private void InstalledView_Checked(object sender, RoutedEventArgs e)\n    {\n        // IsChecked=\"True\" in XAML fires this during InitializeComponent, before\n        // the sibling toggles/grids exist -- skip until the window is loaded.\n        if (!IsLoaded) return;\n        if (sender is not ToggleButton tb || tb.IsChecked != true) return;\n        bool tiles = tb.Tag?.ToString() == \"Tiles\";\n        if (tiles) InstalledListToggle.IsChecked = false; else InstalledTilesToggle.IsChecked = false;\n        DownloadedModsGrid.Visibility = tiles ? Visibility.Collapsed : Visibility.Visible;\n        InstalledTiles.Visibility = tiles ? Visibility.Visible : Visibility.Collapsed;\n    }\n\n    private void DownloadsView_Checked(object sender, RoutedEventArgs e)\n    {\n        if (!IsLoaded) return;\n        if (sender is not ToggleButton tb || tb.IsChecked != true) return;\n        bool tiles = tb.Tag?.ToString() == \"Tiles\";\n        if (tiles) DownloadsListToggle.IsChecked = false; else DownloadsTilesToggle.IsChecked = false;\n        DownloadsGrid.Visibility = tiles ? Visibility.Collapsed : Visibility.Visible;\n        DownloadsTiles.Visibility = tiles ? Visibility.Visible : Visibility.Collapsed;\n    }\n\n    private void UninstalledView_Checked(object sender, RoutedEventArgs e)\n    {\n        if (!IsLoaded) return;\n        if (sender is not ToggleButton tb || tb.IsChecked != true) return;\n        bool tiles = tb.Tag?.ToString() == \"Tiles\";\n        if (tiles) UninstalledListToggle.IsChecked = false; else UninstalledTilesToggle.IsChecked = false;\n        UninstalledModsGrid.Visibility = tiles ? Visibility.Collapsed : Visibility.Visible;\n        UninstalledTiles.Visibility = tiles ? Visibility.Visible : Visibility.Collapsed;\n    }\n\n    /// <summary>Shared tile-size slider: updates the app-wide ModTileSize resource live.</summary>\n    private void ModTileSize_Changed(object sender, RoutedPropertyChangedEventArgs<double> e)\n    {\n        if (!IsLoaded) return;\n        Application.Current.Resources[\"ModTileSize\"] = e.NewValue;\n    }\n\n    private void OpenFolder_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is FrameworkElement fe && fe.Tag is string path && Directory.Exists(path))\n        {\n            try\n            {\n                Process.Start(new ProcessStartInfo(\"explorer.exe\", $\"\\\"{path}\\\"\") { UseShellExecute = true });\n            }\n            catch (Exception ex)\n            {\n                MessageBox.Show($\"Could not open folder: {ex.Message}\");\n            }\n        }\n    }\n\n    private static long GetDirectorySize(string path)\n    {\n        long total = 0;\n        try\n        {\n            foreach (var f in Directory.EnumerateFiles(path, \"*\", SearchOption.AllDirectories))\n                total += new FileInfo(f).Length;\n        }\n        catch { /* ignore inaccessible files */ }\n        return total;\n    }\n\n    private static string FormatSize(long bytes)\n    {\n        double mb = bytes / 1024.0 / 1024.0;\n        return mb < 0.01 ? $\"{bytes} B\" : $\"{mb:0.###} MB\";\n    }\n\n    // ================= Updater tab =================\n\n    private void OpenPzFolder_Click(object sender, RoutedEventArgs e) => PickModsFolder();\n\n    private async void UpdateAllButton_Click(object sender, RoutedEventArgs e)\n    {\n        var toUpdate = _downloadedMods.Where(m => m.NeedsUpdate).ToList();\n        if (toUpdate.Count == 0)\n        {\n            MessageBox.Show(\"No updates available. Try 'Refresh Mod List' first.\");\n            return;\n        }\n\n        AppendLog($\"Updating all: {toUpdate.Count} mod(s)...\");\n        foreach (var mod in toUpdate)\n        {\n            if (_settings.BackupUpdatedMods) BackupMod(mod.Folder);\n            RemoveOldModFolder(mod.Folder);\n            await StartDownloadAsync(mod.Id, mod.ModName, showFolderWarning: false);\n        }\n\n        await RefreshDownloadedModsAsync();\n    }\n\n    /// <summary>\n    /// Deletes the folder currently on disk for a mod before an update\n    /// redownloads it. This matters because SteamCMD's fresh download can\n    /// name the mod's folder slightly differently than what's already\n    /// installed (renamed subfolder, capitalization change, etc.) -- the\n    /// installer only overwrites a folder when the name matches exactly,\n    /// so without this step a mismatch leaves the old copy behind and\n    /// creates a duplicate instead of replacing it.\n    /// </summary>\n    private void RemoveOldModFolder(string folderName)\n    {\n        try\n        {\n            var path = Path.Combine(_settings.ModsFolder, folderName);\n            if (Directory.Exists(path)) Directory.Delete(path, recursive: true);\n        }\n        catch (Exception ex)\n        {\n            // Best-effort -- if this fails, the download will still overwrite\n            // any folder whose name happens to match exactly.\n            AppendLog($\"Could not remove old folder \\\"{folderName}\\\" before redownload: {ex.Message}\", \"WARNING\");\n        }\n    }\n\n    private void BackupMod(string folderName)\n    {\n        try\n        {\n            var src = Path.Combine(_settings.ModsFolder, folderName);\n            if (!Directory.Exists(src)) return;\n            var backupDir = Path.Combine(_settings.ModsFolder, \"_backups\", folderName, DateTime.Now.ToString(\"yyyyMMdd_HHmmss\"));\n            Directory.CreateDirectory(Path.GetDirectoryName(backupDir)!);\n            CopyDirectory(src, backupDir);\n        }\n        catch\n        {\n            // Best-effort backup; don't block the update if it fails.\n        }\n    }\n\n    private static void CopyDirectory(string sourceDir, string destDir)\n    {\n        Directory.CreateDirectory(destDir);\n        foreach (var file in Directory.GetFiles(sourceDir))\n            File.Copy(file, Path.Combine(destDir, Path.GetFileName(file)), overwrite: true);\n        foreach (var dir in Directory.GetDirectories(sourceDir))\n            CopyDirectory(dir, Path.Combine(destDir, Path.GetFileName(dir)));\n    }\n\n    private void ModPage_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is FrameworkElement fe && fe.Tag is not null)\n        {\n            string? id = fe.Tag switch\n            {\n                string s => s,\n                ModRecord m => m.Id,\n                DownloadTask d => d.Id,\n                UninstalledModEntry u => u.Id,\n                _ => null,\n            };\n            if (!string.IsNullOrEmpty(id))\n            {\n                Navigate($\"https://steamcommunity.com/sharedfiles/filedetails/?id={id}\");\n                MainTabs.SelectedItem = BrowserTabItem;\n            }\n        }\n    }\n\n    private async void UpdateSingleMod_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is FrameworkElement fe && fe.Tag is ModRecord mod)\n            await ForceRedownloadAsync(mod, \"Updating\");\n    }\n\n    private async void ForceRedownloadMod_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is FrameworkElement fe && fe.Tag is ModRecord mod)\n            await ForceRedownloadAsync(mod, \"Force redownloading\");\n    }\n\n    /// <summary>\n    /// \"Show Deps\" button on an Installed Mods row. The Steam Workshop page for\n    /// the selected mod is the authoritative source of its dependencies: the\n    /// \"Required items\" section lists every dependency (workshop id + name),\n    /// whether or not it's installed. So the popup is populated from that page\n    /// and each entry is annotated installed/missing by comparing its workshop id\n    /// against the installed-mod index.\n    ///\n    /// This lookup happens ONLY here, on explicit user action -- never during\n    /// startup or the Installed Mods refresh -- and fetches ONLY this mod's page\n    /// (no recursive dependency-page requests). Results are cached per session\n    /// and concurrent duplicate clicks are ignored.\n    /// </summary>\n    private async void ShowDeps_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is not FrameworkElement fe || fe.Tag is not ModRecord mod) return;\n\n        // Authoritative installed-workshop-id set for the installed/missing flag.\n        var installedIds = _downloadedMods.Select(m => m.Id).ToHashSet(StringComparer.Ordinal);\n\n        // Fetch ONLY this mod's page. Per-session cache avoids re-downloading;\n        // the in-flight guard drops duplicate clicks while a fetch is running.\n        List<WorkshopRequiredItem> pageItems;\n        string? pageError = null;\n        if (_depsPageCache.TryGetValue(mod.Id, out var cached))\n        {\n            pageItems = cached;\n        }\n        else if (!_depsFetchInFlight.Add(mod.Id))\n        {\n            AppendLog($\"Dependency lookup for \\\"{mod.ModName}\\\" is already in progress; ignoring repeat click.\", \"WARNING\");\n            return;\n        }\n        else\n        {\n            try\n            {\n                pageItems = await WorkshopPageService.GetRequiredItemsAsync(mod.Id);\n                _depsPageCache[mod.Id] = pageItems;\n                if (pageItems.Count > 0)\n                    AppendLog($\"Loaded {pageItems.Count} required item link(s) from the Workshop page for \\\"{mod.ModName}\\\".\");\n            }\n            catch (Exception ex)\n            {\n                pageItems = new List<WorkshopRequiredItem>();\n                pageError = ex.Message;\n                AppendLog($\"Could not read required items from the Workshop page for \\\"{mod.ModName}\\\": {ex.Message}\", \"WARNING\");\n            }\n            finally\n            {\n                _depsFetchInFlight.Remove(mod.Id);\n            }\n        }\n\n        // The page is authoritative: show every required item, installed or not.\n        var displays = new List<DepDisplay>();\n        foreach (var pi in pageItems)\n        {\n            displays.Add(new DepDisplay\n            {\n                Identifier = pi.Id,\n                Title = pi.Title,\n                WorkshopId = pi.Id,\n                IsMissing = !installedIds.Contains(pi.Id),\n            });\n        }\n\n        // Safety net for mods whose Steam page has no \"Required items\" section:\n        // fall back to mod.info require= resolution so locally-known deps still show.\n        if (displays.Count == 0)\n            displays = BuildModInfoDisplays(mod);\n\n        var dlg = new DepsDialog(\n            mod.ModName,\n            displays,\n            queueOne: d => AddDependencyToQueue(d),\n            openPage: d => OpenDependencyPage(d))\n        { Owner = this };\n\n        if (pageError != null)\n            dlg.ShowError($\"Could not load the Workshop page for \\\"{mod.ModName}\\\":\\n{pageError}\\n\\n\" +\n                          (displays.Count > 0 ? \"Showing locally-known requirements instead.\" : \"\"));\n\n        dlg.ShowDialog();\n    }\n\n    /// <summary>\n    /// Fallback used when the Workshop page has no required-items section:\n    /// resolves the mod.info require= entries against installed mods'\n    /// id=/name= identifiers (numeric entries are already workshop ids).\n    /// </summary>\n    private List<DepDisplay> BuildModInfoDisplays(ModRecord mod)\n    {\n        var installedIndex = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);\n        foreach (var installed in _downloadedMods)\n        {\n            foreach (var ident in SteamCmdService.GetModIdentifiers(installed.FullPath))\n            {\n                var key = NormalizeModIdentifier(ident);\n                if (key.Length > 0) installedIndex.TryAdd(key, installed.Id);\n            }\n        }\n\n        var displays = new List<DepDisplay>();\n        foreach (var req in mod.Dependencies)\n        {\n            string? wsId = null;\n            string title = req;\n\n            if (long.TryParse(req, out _))\n            {\n                wsId = req; // numeric require= is already the workshop id\n                var installed = _downloadedMods.FirstOrDefault(m => m.Id == req);\n                if (installed != null) title = installed.ModName;\n            }\n            else\n            {\n                var key = NormalizeModIdentifier(req);\n                if (installedIndex.TryGetValue(key, out var localId))\n                {\n                    wsId = localId; // matched against an installed mod\n                    var installed = _downloadedMods.FirstOrDefault(m => m.Id == localId);\n                    if (installed != null) title = installed.ModName;\n                }\n            }\n\n            displays.Add(new DepDisplay\n            {\n                Identifier = req,\n                Title = title,\n                WorkshopId = wsId,\n                IsMissing = wsId == null || !_downloadedMods.Any(m => m.Id == wsId),\n            });\n        }\n        return displays;\n    }\n\n    private void AddDependencyToQueue(DepDisplay d)\n    {\n        if (d.WorkshopId == null) return;\n        if (_queue.Any(q => q.Id == d.WorkshopId)) return;\n        _queue.Add(new QueueItem { Id = d.WorkshopId, Title = d.Title, Status = \"Queued\" });\n        AppendLog($\"Queued dependency: {d.Title} ({d.WorkshopId})\");\n    }\n\n    private void OpenDependencyPage(DepDisplay d)\n    {\n        if (d.WorkshopId != null)\n        {\n            Navigate($\"https://steamcommunity.com/sharedfiles/filedetails/?id={d.WorkshopId}\");\n        }\n        else\n        {\n            // No known id -- search Steam for the identifier instead.\n            Navigate($\"https://steamcommunity.com/workshop/browse/?appid={SteamCmdService.AppId}&searchtext=\" +\n                     Uri.EscapeDataString(d.Identifier));\n        }\n        MainTabs.SelectedItem = BrowserTabItem;\n    }\n\n    /// <summary>\n    /// Shared by both the per-row Update button (only shown when a mod\n    /// actually needs updating) and the always-visible Force Redownload\n    /// button -- both do the same underlying operation, just gated\n    /// differently in the UI.\n    /// </summary>\n    private async Task ForceRedownloadAsync(ModRecord mod, string logVerb)\n    {\n        if (_settings.BackupUpdatedMods) BackupMod(mod.Folder);\n        RemoveOldModFolder(mod.Folder);\n        AppendLog($\"{logVerb}: {mod.ModName}\");\n        await StartDownloadAsync(mod.Id, mod.ModName, showFolderWarning: false);\n        await RefreshDownloadedModsAsync();\n    }\n\n    private void UninstallMod_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is not FrameworkElement fe || fe.Tag is not ModRecord mod) return;\n\n        var confirm = MessageBox.Show(\n            $\"Uninstall \\\"{mod.ModName}\\\"?\\n\\nThe mod folder will be deleted. \" +\n            \"You can reinstall it later from the Uninstalled Mods tab.\",\n            \"Confirm Uninstall\", MessageBoxButton.YesNo, MessageBoxImage.Warning);\n        if (confirm != MessageBoxResult.Yes) return;\n\n        try\n        {\n            var path = Path.Combine(_settings.ModsFolder, mod.Folder);\n            if (Directory.Exists(path)) Directory.Delete(path, recursive: true);\n        }\n        catch (Exception ex)\n        {\n            MessageBox.Show($\"Could not delete folder: {ex.Message}\");\n            AppendLog($\"FAILED to uninstall {mod.ModName}: {ex.Message}\", \"ERROR\");\n            return;\n        }\n\n        _uninstalledMods.Insert(0, new UninstalledModEntry\n        {\n            Id = mod.Id,\n            ModName = mod.ModName,\n            Author = mod.Creator,\n            UninstallDate = DateTime.Now.ToString(\"dd-MMM-yy h:mm:ss tt\"),\n        });\n        UninstalledModsStore.Save(_uninstalledMods.ToList());\n\n        AppendLog($\"Uninstalled: {mod.ModName}\");\n        StatusText.Text = $\"Uninstalled: {mod.ModName}\";\n        _ = RefreshDownloadedModsAsync();\n    }\n\n    private async void ReinstallMod_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is not FrameworkElement fe || fe.Tag is not UninstalledModEntry entry) return;\n\n        AppendLog($\"Reinstalling: {entry.ModName}\");\n        var ok = await StartDownloadAsync(entry.Id, entry.ModName);\n        if (ok)\n        {\n            _uninstalledMods.Remove(entry);\n            UninstalledModsStore.Save(_uninstalledMods.ToList());\n        }\n    }\n\n    private void ForgetUninstalledMod_Click(object sender, RoutedEventArgs e)\n    {\n        if (sender is not FrameworkElement fe || fe.Tag is not UninstalledModEntry entry) return;\n        _uninstalledMods.Remove(entry);\n        UninstalledModsStore.Save(_uninstalledMods.ToList());",
