              "newString": "    // ================= Settings: SteamCMD workshop content cache =================\n\n    /// <summary>\n    /// Deletes the cached workshop item content under the steamcmd folder.\n    /// Only the app's own per-item download cache is removed (SteamCMD exe,\n    /// its config files and login state are untouched), so the next download\n    /// re-fetches fresh copies. Runs under SteamCMD's run lock so it cannot\n    /// clash with a download in progress.\n    /// </summary>\n    private async void ClearSteamCmdCache_Click(object sender, RoutedEventArgs e)\n    {\n        var root = SteamCmdService.GetWorkshopContentRoot();\n        var confirm = MessageBox.Show(\n            \"Delete the SteamCMD workshop download cache?\\n\\n\" +\n            $\"Location: {root}\\n\\n\" +\n            \"This deletes the cached copies of every downloaded workshop item. \" +\n            \"Mods already installed in your mods folder are NOT affected, and SteamCMD itself \" +\n            \"(its program files and login) will keep working.\\n\\nThe next time a mod is downloaded, \" +\n            \"a fresh copy will be fetched from Steam.\",\n            \"Clear Workshop Mods Cache\", MessageBoxButton.YesNo, MessageBoxImage.Question);\n        if (confirm != MessageBoxResult.Yes)\n        {\n            AppendLog(\"Clear workshop cache cancelled.\");\n            return;\n        }\n\n        AppendLog(\"Clearing SteamCMD workshop content cache...\");\n        if (!Directory.Exists(root))\n        {\n            AppendLog(\"Workshop content cache is already empty (SteamCMD has not downloaded anything yet).\", \"INFO\");\n            StatusText.Text = \"Workshop cache already empty.\";\n            return;\n        }\n\n        var result = await SteamCmdService.WithSteamCmdLockAsync(async () =>\n        {\n            var deleted = 0;\n            foreach (var dir in Directory.GetDirectories(root))\n                try { Directory.Delete(dir, recursive: true); deleted++; }\n                catch (Exception ex) { AppendLog($\"Could not delete cached item \\\"{Path.GetFileName(dir)}\\\": {ex.Message}\", \"WARNING\"); }\n\n            var files = 0L;\n            foreach (var f in Directory.EnumerateFiles(root, \"*\", SearchOption.AllDirectories))\n            {\n                try { File.Delete(f); files++; }\n                catch { }\n            }\n            return (deleted, files);\n        });\n\n        if (result.Equals(default))\n        {\n            AppendLog(\"Could not clear the workshop content cache.\", \"ERROR\");\n            StatusText.Text = \"Failed to clear workshop cache.\";\n        }\n        else\n        {\n            AppendLog($\"Workshop cache cleared: {result.deleted} item folder(s), {result.files} file(s) removed.\");\n            StatusText.Text = $\"Workshop cache cleared ({result.deleted} item(s), {result.files} file(s)).\";\n        }\n    }\n\n    // ================= Settings toggles / theme =================\n\n    private void SettingsCheckbox_Changed(object sender, RoutedEventArgs e)"
